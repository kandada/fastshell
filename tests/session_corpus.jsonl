"python3 - << 'EOF'\nimport re, zlib\ndata = open('attachments/谢先生简历_1786313577.pdf','rb').read()\nobj_pat = re.compile(rb\"(\\d+)\\s+(\\d+)\\s+obj\\b(.*?)endobj\", re.S)\nobjs = {}\nfor m in obj_pat.finditer(data):\n    objs[int(m.group(1))] = m.group(3)\ndef decompress(body):\n    m = re.search(rb\"stream\\r?\\n(.*?)endstream\", body, re.S)\n    if not m: return None\n    raw = m.group(1)\n    if raw.endswith(b\"\\r\\n\"): raw = raw[:-2]\n    elif raw.endswith(b\"\\n\") or raw.endswith(b\"\\r\"): raw = raw[:-1]\n    try: return zlib.decompress(raw)\n    except Exception: return None\nfor num, body in list(objs.items()):\n    if b\"/Type /ObjStm\" in body:\n        dec = decompress(body)\n        if not dec: continue\n        m2 = re.match(rb\"((?:\\d+\\s+\\d+\\s+)+)\", dec)\n        hdr_end = m2.end()\n        pairs = re.findall(rb\"(\\d+)\\s+(\\d+)\", dec[:hdr_end])\n        for i,(a,b) in enumerate(pairs):\n            a,b=int(a),int(b)\n            objs[a] = dec[hdr_end+b: hdr_end+int(pairs[i+1][1]) if i+1<len(pairs) else len(dec)]\n\n# 复用 extract_clean 的解析逻辑, 打印第1页头部几行的 (y, x, text)\nimport importlib.util\nspec = importlib.util.spec_from_file_location(\"ec\", \"extract_clean.py\")\nec = importlib.util.module_from_spec(spec)\nimport sys\nsys.modules['ec'] = ec\nspec.loader.exec_module(ec)\n\ndata, objs, decompress = ec.load_objects(ec.PDF_PATH)\nfont_to_cmap, font_num_to_name = {}, {}\nfor num, body in objs.items():\n    if b\"/Type /Font\" in body and b\"/ToUnicode\" in body:\n        bf = re.search(rb\"/BaseFont\\s*/([^\\s/<>\\[\\]]+)\", body)\n        tnum = re.search(rb\"/ToUnicode\\s+(\\d+)\\s+\\d+\\s+R\", body)\n        if not (bf and tnum): continue\n        fname = bf.group(1).decode('latin1')\n        font_num_to_name[num] = fname\n        t = int(tnum.group(1))\n        if t in objs:\n            dec = decompress(objs[t]) or objs[t]\n            font_to_cmap[fname] = ec.parse_cmap(dec)\n\nbody = objs[2]\nfm = {}\nm = re.search(rb\"/Font\\s*<<(.*?)>>\", body, re.S)\nif m:\n    for ref in ec.RE_FONT_REF.findall(m.group(1)):\n        parts = ref.split()\n        fm[parts[0][1:].decode()] = font_to_cmap.get(font_num_to_name.get(int(parts[1])), {})\n\ncontent = decompress(objs[16])\ncur_font, cur_x, cur_y = None, 0.0, 0.0\nchars = []\ncomb = re.compile(\n    rb\"([A-Za-z]\\d+)\\s+[\\d.]+\\s+Tf|<([0-9A-Fa-f\\s]+)>\\s*Tj|\\(((?:[^()\\\\]|\\\\.)*)\\)\\s*Tj|\\[(.*?)\\]\\s*TJ|([\\d.+-]+)\\s+([\\d.+-]+)\\s+([\\d.+-]+)\\s+([\\d.+-]+)\\s+([\\d.+-]+)\\s+([\\d.+-]+)\\s+Tm|([\\d.+-]+)\\s+([\\d.+-]+)\\s+Td|(T\\*|Td|TD|Tm|BT|ET)\")\nfor mt in comb.finditer(content):\n    g = mt.groups()\n    if g[0] is not None: cur_font = g[0].decode()\n    elif g[1] is not None: chars.append((round(cur_y), cur_x, ec.decode_hex(g[1], fm.get(cur_font, {}))))\n    elif g[2] is not None: chars.append((round(cur_y), cur_x, ec.unescape_literal(g[2].decode('latin1'))))\n    elif g[3] is not None:\n        for atom in ec.RE_HEX_ATOM.finditer(g[3]): chars.append((round(cur_y), cur_x, ec.decode_hex(atom.group(1), fm.get(cur_font, {}))))\n        for atom in ec.RE_LIT_ATOM.finditer(g[3]): chars.append((round(cur_y), cur_x, ec.unescape_literal(atom.group(1).decode('latin1'))))\n    elif g[4] is not None: cur_x, cur_y = float(g[8]), float(g[9])\n    elif g[10] is not None: cur_x += float(g[10]); cur_y += float(g[11])\n\nfrom collections import defaultdict\ngrp = defaultdict(list)\nfor y, x, t in chars: grp[y].append((x, t))\nfor y in sorted(grp)[:6]:\n    segs = sorted(grp[y])\n    xs = [x for x, _ in segs]\n    gaps = [round(xs[i+1]-xs[i],1) for i in range(len(xs)-1)]\n    print(f\"y={y} text={''.join(t for _,t in segs)}\")\n    print(f\"   x={xs[:20]}\")\n    print(f\"   gaps={gaps[:24]}\")\nEOF"
"python3 - << 'EOF'\nsrc = open('extract_clean.py').read()\nold = '''    lines = []\n    for y in sorted(groups):\n        segs = sorted(groups[y])\n        xs = [x for x, _ in segs]\n        med = 0.0\n        if len(segs) >= 3:\n            gaps = sorted([xs[i+1] - xs[i] for i in range(len(xs)-1)])\n            med = gaps[len(gaps)//2]\n        parts = []\n        for i, (x, t) in enumerate(segs):\n            if i > 0 and med > 0 and (x - xs[i-1]) > med * 1.5:\n                parts.append(\" \")\n            parts.append(t)\n        lines.append(\"\".join(parts))\n    return \"\\\\n\".join(lines)'''\nnew = '''    lines = []\n    for y in sorted(groups):\n        segs = sorted(groups[y])\n        xs = [x for x, _ in segs]\n        # 众数间距(按2单位分箱) * 1.6 作为空格阈值\n        thresh = float(\"inf\")\n        if len(segs) >= 3:\n            gaps = [xs[i+1] - xs[i] for i in range(len(xs)-1)]\n            cnt = {}\n            for g in gaps:\n                b = round(g / 2) * 2\n                cnt[b] = cnt.get(b, 0) + 1\n            modal = max(cnt, key=lambda k: (cnt[k], k))\n            thresh = max(modal * 1.6, 10.0)\n        parts = []\n        for i, (x, t) in enumerate(segs):\n            if i > 0 and (x - xs[i-1]) > thresh:\n                parts.append(\" \")\n            parts.append(t)\n        lines.append(\"\".join(parts))\n    return \"\\\\n\".join(lines)'''\nassert old in src, \"block not found\"\nopen('extract_clean.py','w').write(src.replace(old, new))\nprint(\"patched\")\nEOF\npython3 extract_clean.py 2>/dev/null > resume_extracted.txt; echo \"exit=$?\"; cat resume_extracted.txt"
