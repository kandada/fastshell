并模式(全部以组/< 开头, 避免引擎bug)\n    comb = re.compile(\n        rb\"([A-Za-z]\\\\d+)\\\\s+[\\\\d.]+\\\\s+Tf\"\n        rb\"|<([0-9A-Fa-f\\\\s]+)>\\\\s*Tj\"\n        rb\"|\\\\(((?:[^()\\\\\\\\]|\\\\\\\\.)*)\\\\)\\\\s*Tj\"\n        rb\"|\\\\[(.*?)\\\\]\\\\s*TJ\"\n        rb\"|(T\\\\*|Td|TD|Tm|BT|ET)\"\n    )\n    for mt in comb.finditer(content):\n        g = mt.groups()\n        if g[0] is not None:\n            cur_font = g[0].decode()\n        elif g[1] is not None:\n            cmap = fm.get(cur_font, {}) if cur_font else {}\n            line.append(decode_hex(g[1], cmap))\n        elif g[2] is not None:\n            line.append(unescape_literal(g[2].decode('latin1')))\n        elif g[3] is not None:\n            cmap = fm.get(cur_font, {}) if cur_font else {}\n            for atom in RE_HEX_ATOM.finditer(g[3]):\n                line.append(decode_hex(atom.group(1), cmap))\n            for atom in RE_LIT_ATOM.finditer(g[3]):\n                line.append(unescape_literal(atom.group(1).decode('latin1')))\n        else:\n            op = g[4]\n            if op in (b'T*', b'Td', b'TD', b'Tm', b'ET'):\n                out_lines.append(\"\".join(line))\n                line = []\n    if line:\n        out_lines.append(\"\".join(line))\n    return \"\\\\n\".join(out_lines)'''\nassert old in src, \"block not found\"\nopen('extract_clean.py','w').write(src.replace(old, new))\nprint(\"patched\")\nEOF\npython3 extract_clean.py 2>/dev/null | head -120"
"python3 - << 'EOF'\n# 检查内容流中 Tm/Td 用法，确认坐标还原可行性\nimport re, zlib\ndata = open('attachments/谢先生简历_1786313577.pdf','rb').read()\nobj_pat = re.compile(rb\"(\\d+)\\s+(\\d+)\\s+obj\\b(.*?)endobj\", re.S)\nobjs = {}\nfor m in obj_pat.finditer(data):\n    objs[int(m.group(1))] = m.group(3)\ndef decompress(body):\n    m = re.search(rb\"stream\\r?\\n(.*?)endstream\", body, re.S)\n    if not m: return None\n    raw = m.group(1)\n    if raw.endswith(b\"\\r\\n\"): raw = raw[:-2]\n    elif raw.endswith(b\"\\n\") or raw.endswith(b\"\\r\"): raw = raw[:-1]\n    try: return zlib.decompress(raw)\n    except Exception: return None\nfor num, body in list(objs.items()):\n    if b\"/Type /ObjStm\" in body:\n        dec = decompress(body)\n        if not dec: continue\n        m2 = re.match(rb\"((?:\\d+\\s+\\d+\\s+)+)\", dec)\n        hdr_end = m2.end()\n        pairs = re.findall(rb\"(\\d+)\\s+(\\d+)\", dec[:hdr_end])\n        for i,(a,b) in enumerate(pairs):\n            a,b=int(a),int(b)\n            objs[a] = dec[hdr_end+b: hdr_end+int(pairs[i+1][1]) if i+1<len(pairs) else len(dec)]\n\nc = decompress(objs[16])\ns = c.decode('latin1')\n# 统计文本定位操作\nprint(\"Tm count:\", len(re.findall(r\"[\\d.+-]+\\s+[\\d.+-]+\\s+[\\d.+-]+\\s+[\\d.+-]+\\s+[\\d.+-]+\\s+[\\d.+-]+\\s+Tm\", s)))\nprint(\"Td count:\", len(re.findall(r\"[\\d.+-]+\\s+[\\d.+-]+\\s+Td\", s)))\nprint(\"TD count:\", len(re.findall(r\"[\\d.+-]+\\s+[\\d.+-]+\\s+TD\", s)))\nprint(\"T* count:\", len(re.findall(r\"T\\*\", s)))\n# 看几个带 dy 的 Td\nfor m in list(re.finditer(r\"([\\d.+-]+)\\s+([\\d.+-]+)\\s+Td\", s))[:15]:\n    dx, dy = m.group(1), m.group(2)\n    if dy != '0':\n        print(\"Td with dy:\", dx, dy)\n# Tm 样例\nfor m in list(re.finditer(r\"([\\d.+-]+)\\s+([\\d.+-]+)\\s+([\\d.+-]+)\\s+([\\d.+-]+)\\s+([\\d.+-]+)\\s+([\\d.+-]+)\\s+Tm\", s))[:8]:\n    print(\"Tm:\", m.groups())\nEOF"
