"python3 - << 'EOF'\n# 直接内联调试 extract_clean 的核心渲染流程\nimport re, zlib, sys\nsys.path.insert(0, '.')\nexec(open('extract_clean.py').read().replace('if __name__ == \"__main__\":\\n    main()', 'pass'))\n\ndata, objs, decompress = load_objects(PDF_PATH)\n\n# 字体 -> ToUnicode cmap\nfont_to_cmap = {}\nfont_num_to_name = {}\nfor num, body in objs.items():\n    if b\"/Type /Font\" in body and b\"/ToUnicode\" in body:\n        bf = re.search(rb\"/BaseFont\\s*/([^\\s/<>\\[\\]]+)\", body)\n        tnum = re.search(rb\"/ToUnicode\\s+(\\d+)\\s+\\d+\\s+R\", body)\n        if not (bf and tnum): continue\n        fname = bf.group(1).decode('latin1')\n        font_num_to_name[num] = fname\n        t = int(tnum.group(1))\n        if t in objs:\n            dec = decompress(objs[t]) or objs[t]\n            font_to_cmap[fname] = parse_cmap(dec)\nprint(\"cmap sizes:\", {k: len(v) for k, v in font_to_cmap.items()})\n\ndef decode_hex(hexs, cmap):\n    hexs = re.sub(rb\"\\s\", b\"\", hexs)\n    out = []\n    for j in range(0, len(hexs), 4):\n        code = int(hexs[j:j+4], 16)\n        if code in cmap:\n            out.append(cmap[code])\n        elif code < 128:\n            out.append(chr(code))\n        else:\n            out.append(f\"[CID{code:04X}]\")\n    return \"\".join(out)\n\n# 测试第1页\nbody = objs[2]\nfm = {}\nm = re.search(rb\"/Font\\s*<<(.*?)>>\", body, re.S)\nprint(\"font dict found:\", bool(m))\nif m:\n    for ref in re.finditer(rb\"/(F\\d+)\\s+(\\d+)\\s+\\d+\\s+R\", m.group(1)):\n        fm[ref.group(1).decode()] = font_num_to_name.get(int(ref.group(2)), f\"f{ref.group(2).decode()}\")\nprint(\"fm:\", fm)\nmc = re.search(rb\"/Contents\\s+(\\d+)\\s+\\d+\\s+R\", body)\nprint(\"contents ref:\", mc.group(1) if mc else None)\ncontent = decompress(objs.get(int(mc.group(1)), b\"\")) or b\"\"\nprint(\"content len:\", len(content))\ns = content.decode('latin1')\n# 简单测试：直接找 <...> Tj 片段\ncnt = 0\nfor mt in re.finditer(r'<([0-9A-Fa-f\\s]+)>\\s*Tj', s):\n    cur = 'F6'\n    dec = decode_hex(mt.group(1).encode('latin1'), font_to_cmap.get(fm.get(cur), {}))\n    print(repr(dec[:40]))\n    cnt += 1\n    if cnt >= 10: break\nEOF"
"python3 - << 'EOF'\nimport re\nbody = open('attachments/谢先生简历_1786313577.pdf','rb').read()\n# 直接测正则\nt = b'/Font << /F6 6 0 R /F7 7 0 R /F12 12 0 R >>'\nprint(\"test1:\", re.findall(rb\"/(F\\d+)\\s+(\\d+)\\s+\\d+\\s+R\", t))\nprint(\"test2:\", re.findall(rb\"/(F\\d+)\\s+(\\d+)\\s+(\\d+)\\s+R\", t))\n\n# 从对象2真实内容测\nimport zlib\nobj_pat = re.compile(rb\"(\\d+)\\s+(\\d+)\\s+obj\\b(.*?)endobj\", re.S)\nobjs = {}\nfor m in obj_pat.finditer(body):\n    objs[int(m.group(1))] = m.group(3)\nb2 = objs[2]\nm = re.search(rb\"/Font\\s*<<(.*?)>>\", b2, re.S)\nprint(\"font dict raw:\", m.group(1)[:120] if m else None)\nif m:\n    refs = re.findall(rb\"/(F\\d+)\\s+(\\d+)\\s+\\d+\\s+R\", m.group(1))\n    print(\"refs:\", refs)\nEOF"
"python3 - << 'EOF'\nimport re\nt = b'/Font << /F6 6 0 R /F7 7 0 R /F12 12 0 R >>'\nprint(\"1:\", re.findall(rb\"F\\d+\", t))\nprint(\"2:\", re.findall(rb\"\\d+\", t))\nprint(\"3:\", re.findall(rb\"/F6\", t))\nprint(\"4:\", re.findall(rb\"/F\\d+\", t))\nprint(\"5:\", re.findall(rb\"/(F\\d+)\", t))\nprint(\"6:\", re.findall(rb\"(\\d+)\\s+(\\d+)\\s+R\", t))\nprint(\"7:\", re.findall(rb\"/F6 6 0 R\", t))\nprint(\"8:\", re.findall(rb\"/F6\\s+6\\s+0\\s+R\", t))\nprint(\"9:\", re.findall(rb\"/(F6)\\s+(\\d+)\\s+(\\d+)\\s+R\", t))\nprint(\"10:\", re.findall(rb\"/(F\\d+)\\s+(\\d+)\\s+\\d+\\s+R\", t))\nprint(\"11:\", re.findall(rb\"/F\\d+\\s+\\d+\\s+\\d+\\s+R\", t))\nEOF"
"python3 - << 'EOF'\nimport re\ntests = {\n \"a\": rb\"(F\\d+)\",\n \"b\": rb\"/(F\\d+)\",\n \"c\": rb\"(\\d+)\\s+(\\d+)\",\n \"d\": rb\"x(\\d+)\\s+(\\d+)\",\n \"e\": rb\"(\\d+)\\s+(\\d+)\\s+(\\d+)\",\n \"f\": rb\"(F\\d+)\\s+(\\d+)\\s+(\\d+)\\s+R\",\n \"g\": rb\"(F\\d+)\\s+(\\d+)\",\n \"h\": rb\"<([0-9A-Fa-f]+)>\",\n \"i\": rb\"(T\\*|Td|TD|Tm|BT|ET)\",\n \"j\": rb\"(\\d+)\\s+(\\d+)\\s+R\",\n}\ns = b\"/F6 6 0 R <0015> Td BT\"\nfor k, p in tests.items():\n    try:\n        r = re.findall(p, s)\n        print(k, p, \"->\", r)\n    except Exception as e:\n        print(k, p, \"EXC\", e)\nEOF"
"python3 - << 'EOF'\nimport re\ns = b'/F6 13 Tf <0015> Tj [(ab) <0020> -10] TJ (text) Tj T* Td BT ET'\ntests = {\n \"p1\": rb\"([A-Za-z]\\d+)\\s+[\\d.]+\\s+Tf\",\n \"p2\": rb\"<([0-9A-Fa-f\\s]+)>\\s*Tj\",\n \"p3\": rb\"\\(((?:[^()\\\\]|\\\\.)*)\\)\\s*Tj\",\n \"p4\": rb\"\\[(.*?)\\]\\s*TJ\",\n \"p5\": rb\"(T\\*|Td|TD|Tm|BT|ET)\",\n \"p6\": rb\"([A-Za-z]\\d+)\\s+(\\d+)\\s+(\\d+)\\s+R\",\n}\nfor k, p in tests.items():\n    try:\n        print(k, \"->\", re.findall(p, s))\n    except Exception as e:\n        print(k, \"EXC\", e)\n# 组合模式\ncomb = rb\"([A-Za-z]\\d+)\\s+[\\d.]+\\s+Tf|<([0-9A-Fa-f\\s]+)>\\s*Tj|\\[(.*?)\\]\\s*TJ|(T\\*|Td|TD|Tm|BT|ET)\"\ntry:\n    for mt in re.finditer(comb, s):\n        print(\"MATCH:\", mt.groups())\nexcept Exception as e:\n    print(\"comb EXC\", e)\nEOF"
"cat > extract_clean.py << 'EOF'\n# extract_clean.py - PDF 简历文本提取(适配嵌入式RustPython的re引擎)\n# 注意: 该环境 re 模块对\"捕获组前有字面量字符\"的模式匹配异常,\n#       因此所有关键模式均以组或 < 开头, 或使用无组模式+手工解析。\nimport re, zlib\n\nPDF_PATH = \"attachments/谢先生简历_1786313577.pdf\"\n\ndef load_objects(path):\n    data = open(path, \"rb\").read()\n    obj_pat = re.compile(rb\"(\\d+)\\s+(\\d+)\\s+obj\\b(.*?)endobj\", re.S)\n    objs = {}\n    for m in obj_pat.finditer(data):\n        objs[int(m.group(1))] = m.group(3)\n\n    def decompress(body):\n        m = re.search(rb\"stream\\r?\\n(.*?)endstream\", body, re.S)\n        if not m: return None\n        raw = m.group(1)\n        if raw.endswith(b\"\\r\\n\"): raw = raw[:-2]\n        elif raw.endswith(b\"\\n\") or raw.endswith(b\"\\r\"): raw = raw[:-1]\n        try: return zlib.decompress(raw)\n        except Exception: return None\n\n    # 展开对象流(ObjStm)\n    for num, body in list(objs.items()):\n        if b\"/Type /ObjStm\" in body:\n            dec = decompress(body)\n            if not dec: continue\n            m2 = re.match(rb\"((?:\\d+\\s+\\d+\\s+)+)\", dec)\n            if not m2: continue\n            hdr_end = m2.end()\n            pairs = re.findall(rb\"(\\d+)\\s+(\\d+)\", dec[:hdr_end])\n            for i, (a, b) in enumerate(pairs):\n                a, b = int(a), int(b)\n                start = hdr_end + b\n                end = hdr_end + int(pairs[i+1][1]) if i+1 < len(pairs) else len(dec)\n                objs[a] = dec[start:end]\n    return data, objs, decompress\n\ndef parse_cmap(dec):\n    \"\"\"逐行解析 CMap: bfchar(<src> <dst>) 与 bfrange(<lo> <hi> <dst>)\"\"\"\n    cmap = {}\n    for line in dec.splitlines():\n        line = line.strip()\n        m = re.fullmatch(rb\"<([0-9A-Fa-f]+)>\\s*<([0-9A-Fa-f]+)>(?:\\s*<([0-9A-Fa-f]+)>)?\", line)\n        if not m:\n            continue\n        a = int(m.group(1), 16)\n        if m.group(3) is not None:  # bfrange\n            hi, dst = int(m.group(2), 16), int(m.group(3), 16)\n            for c in range(a, hi + 1):\n                cmap[c] = chr(dst + (c - a))\n        else:  # bfchar\n            try:\n                cmap[a] = bytes.fromhex(m.group(2).decode()).decode(\"utf-16-be\")\n            except Exception:\n                pass\n    return cmap\n\ndef decode_hex(hexs, cmap):\n    \"\"\"Identity-H 2字节CID -> Unicode\"\"\"\n    hexs = re.sub(rb\"\\s\", b\"\", hexs)\n    out = []\n    for j in range(0, len(hexs), 4):\n        code = int(hexs[j:j+4], 16)\n        if code in cmap:\n            out.append(cmap[code])\n        else:\n            out.append(f\"[CID{code:04X}]\")\n    return \"\".join(out)\n\ndef unescape_literal(st):\n    st = re.sub(r'\\\\([nrtbf()\\\\])', lambda mm: {'n':'\\n','r':'\\r','t':'\\t','b':'\\b','f':'\\f'}.get(mm.group(1), mm.group(1)), st)\n    st = re.sub(r'\\\\(\\d{1,3})', lambda mm: chr(int(mm.group(1), 8) & 0xFF), st)\n    return st\n\n# 已验证可用的正则\nRE_FONT_TF   = re.compile(rb\"([A-Za-z]\\d+)\\s+[\\d.]+\\s+Tf\")          # /F6 13 Tf\nRE_HEX_TJ    = re.compile(rb\"<([0-9A-Fa-f\\s]+)>\\s*Tj\")              # <0015> Tj\nRE_LIT_TJ    = re.compile(rb\"\\(((?:[^()\\\\]|\\\\.)*)\\)\\s*Tj\")          # (text) Tj\nRE_TJ_ARRAY  = re.compile(rb\"\\[(.*?)\\]\\s*TJ\")                       # [(...) <..> n] TJ\nRE_OPS       = re.compile(rb\"(T\\*|Td|TD|Tm|BT|ET)\")                 # 文本状态操作\nRE_HEX_ATOM  = re.compile(rb\"<([0-9A-Fa-f\\s]+)>\")                   # TJ 数组内 <hex>\nRE_LIT_ATOM  = re.compile(rb\"\\(((?:[^()\\\\]|\\\\.)*)\\)\")               # TJ 数组内 (str)\nRE_FONT_REF  = re.compile(rb\"/F\\d+\\s+\\d+\\s+\\d+\\s+R\")                # 页面字体资源 /F6 6 0 R\n\ndef render_page(page_body, objs, decompress, fm):\n    mc = re.search(rb\"/Contents\\s+(\\d+)\\s+\\d+\\s+R\", page_body)\n    if not mc: return \"\"\n    content = decompress(objs.get(int(mc.group(1)), b\"\")) or b\"\"\n    s = content.decode('latin1')\n\n    cur_font = None\n    out_lines = []\n    line = []\n    tokens = []\n    # 合并模式(全部以组/< 开头, 避免引擎bug)\n    comb = re.compile(\n        rb\"([A-Za-z]\\d+)\\s+[\\d.]+\\s+Tf\"\n        rb\"|<([0-9A-Fa-f\\s]+)>\\s*Tj\"\n        rb\"|\\(((?:[^()\\\\]|\\\\.)*)\\)\\s*Tj\"\n        rb\"|\\[(.*?)\\]\\s*TJ\"\n        rb\"|(T\\*|Td|TD|Tm|BT|ET)\"\n    )\n    for mt in comb.finditer(s):\n        g = mt.groups()\n        if g[0] is not None:\n            cur_font = g[0].decode()\n        elif g[1] is not None:\n            cmap = fm.get(cur_font, {}) if cur_font else {}\n            line.append(decode_hex(g[1].encode('latin1'), cmap))\n        elif g[2] is not None:\n            line.append(unescape_literal(g[2]))\n        elif g[3] is not None:\n            cmap = fm.get(cur_font, {}) if cur_font else {}\n            for atom in RE_HEX_ATOM.finditer(g[3]):\n                line.append(decode_hex(atom.group(1).encode('latin1'), cmap))\n            for atom in RE_LIT_ATOM.finditer(g[3]):\n                line.append(unescape_literal(atom.group(1)))\n        else:\n            op = g[4]\n            if op in (b'T*', b'Td', b'TD', b'Tm', b'ET'):\n                out_lines.append(\"\".join(line))\n                line = []\n    if line:\n        out_lines.append(\"\".join(line))\n    return \"\\n\".join(out_lines)\n\ndef main():\n    data, objs, decompress = load_objects(PDF_PATH)\n\n    # 字体 -> ToUnicode cmap\n    font_to_cmap = {}\n    font_num_to_name = {}\n    for num, body in objs.items():\n        if b\"/Type /Font\" in body and b\"/ToUnicode\" in body:\n            bf = re.search(rb\"/BaseFont\\s*/([^\\s/<>\\[\\]]+)\", body)\n            tnum = re.search(rb\"/ToUnicode\\s+(\\d+)\\s+\\d+\\s+R\", body)\n            if not (bf and tnum): continue\n            fname = bf.group(1).decode('latin1')\n            font_num_to_name[num] = fname\n            t = int(tnum.group(1))\n            if t in objs:\n                dec = decompress(objs[t]) or objs[t]\n                font_to_cmap[fname] = parse_cmap(dec)\n    print(\"// 字体cmap: \", {k: len(v) for k, v in font_to_cmap.items()}, file=__import__('sys').stderr)\n\n    pages = []\n    for pnum, body in sorted(objs.items()):\n        if b\"/Type /Page\" in body and b\"/StructParents\" in body:\n            pages.append((pnum, body))\n\n    print(\"页面总数:\", len(pages))\n    for idx, (pnum, body) in enumerate(pages, 1):\n        # 页面字体资源映射: F6 -> AAAAAA+...\n        fm = {}\n        m = re.search(rb\"/Font\\s*<<(.*?)>>\", body, re.S)\n        if m:\n            for ref in RE_FONT_REF.findall(m.group(1)):\n                parts = ref.split()\n                key = parts[0][1:].decode()          # F6\n                objn = int(parts[1])                  # 6\n                fm[key] = font_to_cmap.get(font_num_to_name.get(objn, key), {})\n        txt = render_page(body, objs, decompress, fm)\n        print(f\"\\n{'='*50}\\n第 {idx} 页\\n{'='*50}\")\n        print(txt)\n\nif __name__ == \"__main__\":\n    main()\nEOF\npython3 extract_clean.py 2>/dev/null | head -100"
