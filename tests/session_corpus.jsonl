"grep -oE \"tu/[0-9]+\" /tmp/ppbc_sp.html | sort -u\necho \"===\"\ngrep -B1 -A2 \"tu/[0-9]\" /tmp/ppbc_sp.html | head -40"
"# The image URL pattern shows image2/{NN}/{HEX32}.jpg\n# The 155 might be a directory hashed from photoid. Let me check the photo page using a photoid we can guess\n# In PPBC, the photo URLs are typically /photo/{photoid} or /tu/{photoid}\n\n# Let me check: maybe photoid = hex part interpreted differently?\n# 33BCF56261CA3EA9 as a 64-bit hex = 0x33BCF56261CA3EA9 = 3728166061920578217 (decimal)\n# This is likely the photo ID. Try visiting\nPID_HEX=33BCF56261CA3EA9\nPID_DEC=$((16#$PID_HEX))\necho \"Photo ID (hex): $PID_HEX\"\necho \"Photo ID (dec): $PID_DEC\"\n\n# Try different URL patterns\nfor url in \\\n  \"http://ppbc.iplant.cn/tu/$PID_DEC\" \\\n  \"http://ppbc.iplant.cn/tu/$PID_HEX\" \\\n  \"http://ppbc.iplant.cn/photo/$PID_DEC\" \\\n  \"http://ppbc.iplant.cn/img/$PID_HEX\" \\\n  ; do\n  echo \"=== $url ===\"\n  curl -sL \"$url\" -A \"Mozilla/5.0\" --max-time 5 -w \"HTTP=%{http_code} size=%{size_download}\\n\" -o /tmp/test_ppbc.html\n  head -c 200 /tmp/test_ppbc.html\n  echo \"\"\ndone"
