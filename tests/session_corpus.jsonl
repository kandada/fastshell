"python3 - << 'EOF'\nimport re, zlib\n\ndata = open('attachments/谢先生简历_1786313577.pdf','rb').read()\nobj_pat = re.compile(rb\"(\\d+)\\s+(\\d+)\\s+obj\\b(.*?)endobj\", re.S)\nobjs = {}\nfor m in obj_pat.finditer(data):\n    objs[int(m.group(1))] = m.group(3)\n\ndef decompress(body):\n    m = re.search(rb\"stream\\r?\\n(.*?)endstream\", body, re.S)\n    if not m: return None\n    raw = m.group(1)\n    if raw.endswith(b\"\\r\\n\"): raw = raw[:-2]\n    elif raw.endswith(b\"\\n\") or raw.endswith(b\"\\r\"): raw = raw[:-1]\n    try: return zlib.decompress(raw)\n    except Exception: return None\n\nfor num, body in list(objs.items()):\n    if b\"/Type /ObjStm\" in body:\n        dec = decompress(body)\n        if not dec: continue\n        m2 = re.match(rb\"((?:\\d+\\s+\\d+\\s+)+)\", dec)\n        hdr_end = m2.end()\n        pairs = re.findall(rb\"(\\d+)\\s+(\\d+)\", dec[:hdr_end])\n        for i,(a,b) in enumerate(pairs):\n            a,b=int(a),int(b)\n            start = hdr_end+b\n            end = hdr_end+int(pairs[i+1][1]) if i+1<len(pairs) else len(dec)\n            objs[a]=dec[start:end]\n\n# 模拟原脚本的字体->cmap逻辑\nfont_to_cmap = {}\nfont_num_to_name = {}\nfor num, body in objs.items():\n    if b\"/Type /Font\" in body:\n        bf = re.search(rb\"/BaseFont\\s*/([^\\s/<>\\[\\]]+)\", body)\n        tnum = re.search(rb\"/ToUnicode\\s+(\\d+)\\s+\\d+\\s+R\", body)\n        fname = bf.group(1).decode('latin1') if bf else f\"font{num}\"\n        font_num_to_name[num] = fname\n        print(num, fname, \"ToUnicode:\", tnum.group(1) if tnum else None, \"in objs:\", int(tnum.group(1)) in objs if tnum else None)\n        if tnum:\n            t = int(tnum.group(1))\n            if t in objs:\n                dec = decompress(objs[t]) or objs[t]\n                print(\"  dec type:\", type(dec).__name__, \"len:\", len(dec) if dec else 0)\n                cmap = {}\n                for m in re.finditer(rb\"<([0-9A-Fa-f]+)>\\s*<([0-9A-Fa-f]+)>\", dec):\n                    try:\n                        cmap[int(m.group(1),16)] = bytes.fromhex(m.group(2).decode()).decode(\"utf-16-be\")\n                    except Exception as e:\n                        print(\"  err:\", e)\n                for m in re.finditer(rb\"<([0-9A-Fa-f]+)>\\s*<([0-9A-Fa-f]+)>\\s*<([0-9A-Fa-f]+)>\", dec):\n                    lo,hi,dst = int(m.group(1),16),int(m.group(2),16),int(m.group(3),16)\n                    for c in range(lo,hi+1):\n                        cmap[c]=chr(dst+(c-lo))\n                font_to_cmap[fname]=cmap\n                print(\"  cmap size:\", len(cmap))\nprint(\"fonts with cmap:\", list(font_to_cmap.keys()))\nEOF"
"cat > extract_clean.py << 'EOF'\n# extract_clean.py - 干净的 PDF 简历文本提取（正确解析 bfchar/bfrange）\nimport re, zlib\n\nPDF_PATH = \"attachments/谢先生简历_1786313577.pdf\"\n\ndef load_objects(path):\n    data = open(path, \"rb\").read()\n    obj_pat = re.compile(rb\"(\\d+)\\s+(\\d+)\\s+obj\\b(.*?)endobj\", re.S)\n    objs = {}\n    for m in obj_pat.finditer(data):\n        objs[int(m.group(1))] = m.group(3)\n\n    def decompress(body):\n        m = re.search(rb\"stream\\r?\\n(.*?)endstream\", body, re.S)\n        if not m: return None\n        raw = m.group(1)\n        if raw.endswith(b\"\\r\\n\"): raw = raw[:-2]\n        elif raw.endswith(b\"\\n\") or raw.endswith(b\"\\r\"): raw = raw[:-1]\n        try: return zlib.decompress(raw)\n        except Exception: return None\n\n    # 展开对象流\n    for num, body in list(objs.items()):\n        if b\"/Type /ObjStm\" in body:\n            dec = decompress(body)\n            if not dec: continue\n            m2 = re.match(rb\"((?:\\d+\\s+\\d+\\s+)+)\", dec)\n            hdr_end = m2.end()\n            pairs = re.findall(rb\"(\\d+)\\s+(\\d+)\", dec[:hdr_end])\n            for i, (a, b) in enumerate(pairs):\n                a, b = int(a), int(b)\n                start = hdr_end + b\n                end = hdr_end + int(pairs[i+1][1]) if i+1 < len(pairs) else len(dec)\n                objs[a] = dec[start:end]\n    return data, objs, decompress\n\ndef parse_cmap(dec):\n    \"\"\"按行解析 CMap: bfchar(<a> <b>) 与 bfrange(<lo> <hi> <dst>)\"\"\"\n    cmap = {}\n    for line in re.findall(rb\"<([0-9A-Fa-f]+)>\\s*<([0-9A-Fa-f]+)>(?:\\s*<([0-9A-Fa-f]+)>)?\", dec):\n        lo = int(line[0], 16)\n        if line[2] is not None:  # bfrange: <lo> <hi> <dst>\n            hi, dst = int(line[1], 16), int(line[2], 16)\n            for c in range(lo, hi + 1):\n                cmap[c] = chr(dst + (c - lo))\n        else:  # bfchar: <src> <dst>\n            try:\n                cmap[lo] = bytes.fromhex(line[1].decode()).decode(\"utf-16-be\")\n            except Exception:\n                pass\n    return cmap\n\ndef main():\n    data, objs, decompress = load_objects(PDF_PATH)\n\n    # 字体 -> ToUnicode cmap\n    font_to_cmap = {}\n    font_num_to_name = {}\n    for num, body in objs.items():\n        if b\"/Type /Font\" in body and b\"/ToUnicode\" in body:\n            bf = re.search(rb\"/BaseFont\\s*/([^\\s/<>\\[\\]]+)\", body)\n            tnum = re.search(rb\"/ToUnicode\\s+(\\d+)\\s+\\d+\\s+R\", body)\n            if not (bf and tnum): continue\n            fname = bf.group(1).decode('latin1')\n            font_num_to_name[num] = fname\n            t = int(tnum.group(1))\n            if t in objs:\n                dec = decompress(objs[t]) or objs[t]\n                font_to_cmap[fname] = parse_cmap(dec)\n\n    def decode_hex(hexs, cmap):\n        hexs = re.sub(rb\"\\s\", b\"\", hexs)\n        out = []\n        for j in range(0, len(hexs), 4):\n            code = int(hexs[j:j+4], 16)\n            if code in cmap:\n                out.append(cmap[code])\n            elif code < 128:\n                out.append(chr(code))\n            else:\n                out.append(f\"[CID{code:04X}]\")\n        return \"\".join(out)\n\n    def render_page(page_body):\n        fm = {}\n        m = re.search(rb\"/Font\\s*<<(.*?)>>\", page_body, re.S)\n        if m:\n            for ref in re.finditer(rb\"/(F\\d+)\\s+(\\d+)\\s+\\d+\\s+R\", m.group(1)):\n                fm[ref.group(1).decode()] = font_num_to_name.get(int(ref.group(2)), f\"f{ref.group(2).decode()}\")\n        def cmap_for(key):\n            return font_to_cmap.get(fm.get(key, key), {})\n        mc = re.search(rb\"/Contents\\s+(\\d+)\\s+\\d+\\s+R\", page_body)\n        if not mc: return \"\"\n        content = decompress(objs.get(int(mc.group(1)), b\"\")) or b\"\"\n        s = content.decode('latin1')\n        cur_font = None\n        out_lines = []\n        line = []\n        pat = re.compile(\n            r'/(F\\d+)\\s+[\\d.]+\\s+Tf'\n            r'|\\\\(((?:[^()\\\\]|\\\\.)*)\\\\)\\s*Tj'\n            r'|<([0-9A-Fa-f\\s]+)>\\s*Tj'\n            r'|\\[(.*?)\\]\\s*TJ'\n            r'|(T\\*|Td|TD|Tm|BT|ET)'\n        )\n        for mt in pat.finditer(s):\n            tok = mt.group(0)\n            if tok.startswith('/'):\n                cur_font = mt.group(1)\n            elif mt.group(2) is not None:\n                st = mt.group(2)\n                st = re.sub(r'\\\\([nrtbf()\\\\])', lambda mm: {'n':'\\n','r':'\\r','t':'\\t','b':'\\b','f':'\\f'}.get(mm.group(1), mm.group(1)), st)\n                st = re.sub(r'\\\\(\\d{1,3})', lambda mm: chr(int(mm.group(1), 8) & 0xFF), st)\n                line.append(st)\n            elif mt.group(3) is not None:\n                cmap = cmap_for(cur_font) if cur_font else {}\n                line.append(decode_hex(mt.group(3).encode('latin1'), cmap))\n            elif mt.group(4) is not None:\n                cmap = cmap_for(cur_font) if cur_font else {}\n                parts = re.findall(r'\\(((?:[^()\\\\]|\\\\.)*)\\)|<([0-9A-Fa-f\\s]+)>', mt.group(4))\n                for ps, hs in parts:\n                    if ps:\n                        ps = re.sub(r'\\\\([nrtbf()\\\\])', lambda mm: {'n':'\\n','r':'\\r','t':'\\t','b':'\\b','f':'\\f'}.get(mm.group(1), mm.group(1)), ps)\n                        line.append(ps)\n                    if hs:\n                        line.append(decode_hex(hs.encode('latin1'), cmap))\n            else:\n                op = mt.group(5)\n                if op in ('T*', 'Td', 'TD', 'Tm', 'ET'):\n                    out_lines.append(\"\".join(line))\n                    line = []\n        if line:\n            out_lines.append(\"\".join(line))\n        return \"\\n\".join(out_lines)\n\n    pages = []\n    for pnum, body in sorted(objs.items()):\n        if b\"/Type /Page\" in body and b\"/StructParents\" in body:\n            pages.append((pnum, body))\n\n    print(\"页面总数:\", len(pages))\n    for idx, (pnum, body) in enumerate(pages, 1):\n        txt = render_page(body)\n        print(f\"\\n{'='*50}\\n第 {idx} 页\\n{'='*50}\")\n        print(txt)\n\nif __name__ == \"__main__\":\n    main()\nEOF\npython3 extract_clean.py"
"python3 - << 'EOF'\n# 修改 parse_cmap 为逐行解析\nimport re\nsrc = open('extract_clean.py').read()\nold = '''def parse_cmap(dec):\n    \"\"\"按行解析 CMap: bfchar(<a> <b>) 与 bfrange(<lo> <hi> <dst>)\"\"\"\n    cmap = {}\n    for line in re.findall(rb\"<([0-9A-Fa-f]+)>\\\\s*<([0-9A-Fa-f]+)>(?:\\\\s*<([0-9A-Fa-f]+)>)?\", dec):\n        lo = int(line[0], 16)\n        if line[2] is not None:  # bfrange: <lo> <hi> <dst>\n            hi, dst = int(line[1], 16), int(line[2], 16)\n            for c in range(lo, hi + 1):\n                cmap[c] = chr(dst + (c - lo))\n        else:  # bfchar: <src> <dst>\n            try:\n                cmap[lo] = bytes.fromhex(line[1].decode()).decode(\"utf-16-be\")\n            except Exception:\n                pass\n    return cmap'''\nnew = '''def parse_cmap(dec):\n    \"\"\"按行解析 CMap: bfchar(<a> <b>) 与 bfrange(<lo> <hi> <dst>)\"\"\"\n    cmap = {}\n    for line in dec.splitlines():\n        line = line.strip()\n        m = re.fullmatch(rb\"<([0-9A-Fa-f]+)>\\\\s*<([0-9A-Fa-f]+)>(?:\\\\s*<([0-9A-Fa-f]+)>)?\", line)\n        if not m:\n            continue\n        a = int(m.group(1), 16)\n        if m.group(3) is not None:  # bfrange: <lo> <hi> <dst>\n            hi, dst = int(m.group(2), 16), int(m.group(3), 16)\n            for c in range(a, hi + 1):\n                cmap[c] = chr(dst + (c - a))\n        else:  # bfchar: <src> <dst>\n            try:\n                cmap[a] = bytes.fromhex(m.group(2).decode()).decode(\"utf-16-be\")\n            except Exception:\n                pass\n    return cmap'''\nassert old in src, \"old block not found\"\nsrc = src.replace(old, new)\nopen('extract_clean.py','w').write(src)\nprint(\"patched OK\")\nEOF\npython3 extract_clean.py > resume_text.txt 2>&1; head -80 resume_text.txt"
"python3 - << 'EOF'\nimport re, zlib\ndata = open('attachments/谢先生简历_1786313577.pdf','rb').read()\nobj_pat = re.compile(rb\"(\\d+)\\s+(\\d+)\\s+obj\\b(.*?)endobj\", re.S)\nobjs = {}\nfor m in obj_pat.finditer(data):\n    objs[int(m.group(1))] = m.group(3)\n\ndef decompress(body):\n    m = re.search(rb\"stream\\r?\\n(.*?)endstream\", body, re.S)\n    if not m: return None\n    raw = m.group(1)\n    if raw.endswith(b\"\\r\\n\"): raw = raw[:-2]\n    elif raw.endswith(b\"\\n\") or raw.endswith(b\"\\r\"): raw = raw[:-1]\n    try: return zlib.decompress(raw)\n    except Exception: return None\n\nfor num, body in list(objs.items()):\n    if b\"/Type /ObjStm\" in body:\n        dec = decompress(body)\n        if not dec: continue\n        m2 = re.match(rb\"((?:\\d+\\s+\\d+\\s+)+)\", dec)\n        hdr_end = m2.end()\n        pairs = re.findall(rb\"(\\d+)\\s+(\\d+)\", dec[:hdr_end])\n        for i,(a,b) in enumerate(pairs):\n            a,b=int(a),int(b)\n            start = hdr_end+b\n            end = hdr_end+int(pairs[i+1][1]) if i+1<len(pairs) else len(dec)\n            objs[a]=dec[start:end]\n\nfor n in [16, 18, 20]:\n    b = objs.get(n)\n    if b is None:\n        print(n, \"MISSING\"); continue\n    print(\"obj\", n, \"type:\", type(b).__name__, \"len:\", len(b), \"is stream:\", b'stream' in b)\n    dec = decompress(b)\n    print(\"  decompressed:\", len(dec) if dec else None)\n    if dec:\n        s = dec[:300]\n        print(\"  sample:\", s.decode('latin1'))\n        print(\"  has Tj:\", b'Tj' in dec, \" has BT:\", b'BT' in dec, \" Tf count:\", dec.count(b'Tf'))\nEOF"
