"python3 << 'PY'\n# 把\"实操篇\"\"对比篇\"内容合并进第一份文档，形成单文档；随后删除多余文件\nimport io, re, os\n\nFIRST = \"OPC一人公司资料汇总.md\"\nEXTRA = [\n    (\"第二部分　实操篇：从 0 到 1 落地\",              \"OPC一人公司创业实操指南.md\"),\n    (\"第三部分　对比篇：一人公司 / 普通公司 / 个体户\", \"一人公司_普通公司_个体户_区别与优势.md\"),\n]\n\ndef read(p): return io.open(p, encoding=\"utf-8\").read().splitlines()\n\ndef split_title(lines):\n    title, body = None, []\n    for ln in lines:\n        if title is None and ln.startswith(\"# \"):\n            title = ln[2:].strip(); continue\n        body.append(ln)\n    return title, body\n\ndef demote(lines, n=1):\n    out = []\n    for ln in lines:\n        m = re.match(r\"^(#{1,6})(\\s)\", ln)\n        out.append(\"#\"*n + ln if m else ln)\n    return out\n\nb_title, b_body = split_title(read(FIRST))\n# 去掉此前插入的、指向将被删除文档的导航行\nb_body = [l for l in b_body if \"相关系列文档\" not in l]\n\nblocks = [\n    (\"第一部分　认知篇：OPC 全面资料\", b_title, b_body),\n]\nfor part_title, path in EXTRA:\n    t, body = split_title(read(path))\n    blocks.append((part_title, t, body))\n\n# 组装\nhead = [\"# 一人公司 OPC 资料大全\", \"\"]\nhead += [\"> 单文档完整版：**认知 + 实操 + 主体对比**一篇看全。内容整理自百度百科、36氪、知乎、OPC圈等公开资料。\", \"\",\n         \"> 阅读顺序建议：先看**第一部分**建立认知，再看**第二部分**学习落地，最后用**第三部分**做主体选择。\", \"\", \"---\", \"\",\n         \"## 目录\", \"\", \"| 部分 | 内容 |\", \"|------|------|\"]\nfor i,(pt,_,_) in enumerate(blocks,1):\n    head.append(\"| %s | %s |\" % (i, pt.split(\"　\",1)[-1]))\nhead += [\"\", \"---\", \"\"]\n\nchunks = [\"\\n\".join(head)]\nfor pt, t, body in blocks:\n    body = [l for l in body]\n    pieces = [\"## \" + pt, \"\", demote(body, 1), \"\", \"---\", \"\"]\n    flat = []\n    for p in pieces:\n        if isinstance(p, list): flat.extend(p)\n        else: flat.append(p)\n    chunks.append(\"\\n\".join(flat))\n\nout = \"\\n\".join(chunks)\nout = re.sub(r\"\\n{4,}\", \"\\n\\n\\n\", out).rstrip() + \"\\n\"\nio.open(FIRST, \"w\", encoding=\"utf-8\").write(out)\nprint(\"已写入:\", FIRST, \"| 行数:\", out.count(\"\\n\")+1, \"| 字符:\", len(out))\n\n# 删除多余文件\nfor f in [\"OPC一人公司创业实操指南.md\", \"一人公司_普通公司_个体户_区别与优势.md\",\n          \"一人公司OPC完全指南_合订本.md\", \"merge_opc.py\"]:\n    if os.path.exists(f):\n        os.remove(f); print(\"已删除:\", f)\nPY"
