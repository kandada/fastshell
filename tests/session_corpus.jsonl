"cat > pos6.py << 'PYEOF'\nimport zlib, re\n\ndata = open('attachments/谢先生简历.pdf','rb').read()\nstreams = []\nfor m in re.finditer(rb'stream\\r?\\n', data):\n    start = m.end()\n    end = data.find(b'endstream', start)\n    if end == -1: continue\n    streams.append(data[start:end].rstrip(b'\\r\\n'))\n\ndef codes_of(h):\n    h = h[1:-1]\n    if len(h) % 4 == 0:\n        return [h[i:i+4] for i in range(0, len(h), 4)]\n    return [h[i:i+2] for i in range(0, len(h), 2)]\n\ncmap = {\n '0015':'2','0013':'0','0014':'1','001C':'9','001B':'8','0018':'5',\n '0011':'.','0010':'-','001A':'7','0019':'6','5365':'至','203C':'今',\n '04A2':'谢','2F64':'先','5041':'生','4053':'男','5F25':'|',\n}\ndef decode(cs):\n    return ''.join(cmap.get(c,'?') for c in cs)\n\nfor si in (12, 14):\n    s = streams[si]\n    try: d = zlib.decompress(s)\n    except Exception: d = s\n    txt = d.decode('latin-1')\n    print(\"=== stream\", si, \"===\")\n    # split into q..Q segments, recording cm ops inside\n    toks = re.findall(r'q|Q|cm|BT|ET|Tm|Tj|<[0-9A-Fa-f]+>', txt)\n    seg = 0\n    i = 0; n = len(toks)\n    segstart = 0\n    while i < n:\n        if toks[i] == 'q':\n            seg += 1\n        elif toks[i] == 'Q':\n            pass\n        i += 1\n    # simpler: print cm context before each BT block\n    pos = 0\n    cm_hist = []\n    for m in re.finditer(r'q|Q|([\\d.\\-]+ [\\d.\\-]+ [\\d.\\-]+ [\\d.\\-]+ [\\d.\\-]+ [\\d.\\-]+) cm|BT', txt):\n        tok = m.group(0)\n        if tok == 'q':\n            cm_hist.append(cm_hist[-1] if cm_hist else 'BASE')\n        elif tok == 'Q':\n            if len(cm_hist) > 1: cm_hist.pop()\n        elif tok.endswith('cm'):\n            cm_hist.append(tok)\n        elif tok == 'BT':\n            # find Tm in the next 400 chars\n            nxt = txt[m.end():m.end()+400]\n            mm = re.search(r'([\\d.\\-]+)\\s+([\\d.\\-]+)\\s+([\\d.\\-]+)\\s+([\\d.\\-]+)\\s+([\\d.\\-]+)\\s+([\\d.\\-]+)\\s+Tm', nxt)\n            if mm:\n                e, f = float(mm.group(5)), float(mm.group(6))\n                # decode text in this BT block\n                btend = txt.find('ET', m.end())\n                blk = txt[m.end():btend]\n                cs = []\n                for h in re.findall(r'<[0-9A-Fa-f]+>', blk):\n                    cs.extend(codes_of(h))\n                print(\"cm=%s  Tm f=%8.1f  %s\" % (cm_hist[-1] if cm_hist else '?', f, decode(cs)[:60]))\nPYEOF\npython3 pos6.py 2>&1 | head -80"
