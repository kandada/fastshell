"echo \"=== 原文档是否被改动（应保持原大小）===\"; ls -la \"OPC一人公司资料汇总.md\" \"OPC一人公司创业实操指南.md\" \"一人公司_普通公司_个体户_区别与优势.md\"\necho\necho \"=== 保真校验：抽取各源文档特征句，确认存在于合订本 ===\"\npython3 << 'PY'\nimport io\nmerged = io.open(\"一人公司OPC完全指南_合订本.md\", encoding=\"utf-8\").read()\nchecks = {\n \"资料汇总\": [\"1600万家\", \"六大成功商业模式\", \"举证责任倒置\", \"失败模式\"],\n \"实操指南\": [\"7 步走\", \"伪 OPC 社区\", \"落地检查清单\", \"一天开业\"],\n \"对比优势\": [\"无限责任\", \"五年制\", \"怎么选\", \"常见误区澄清\"],\n}\n# 修正对比篇的探测词（避免臆造）\nchecks[\"对比优势\"] = [\"无限责任\", \"企业所得税\", \"怎么选？\", \"常见误区澄清\"]\nfor k, ws in checks.items():\n    print(k, \"->\", {w: (w in merged) for w in ws})\n# 反向校验：合订本行数 vs 三源之和（去除标题与导航）\nsrc_lines = 0\nfor p in [\"OPC一人公司资料汇总.md\",\"OPC一人公司创业实操指南.md\",\"一人公司_普通公司_个体户_区别与优势.md\"]:\n    src_lines += len(io.open(p, encoding=\"utf-8\").read().splitlines())\nprint(\"三源总行数:\", src_lines, \" 合订本行数:\", len(merged.splitlines()))\nPY"
"echo \"=== 第一篇→第二篇 边界 ===\"; sed -n '168,182p' \"一人公司OPC完全指南_合订本.md\"\necho; echo \"=== 第二篇→第三篇 边界 ===\"; sed -n '326,340p' \"一人公司OPC完全指南_合订本.md\"\necho; echo \"=== 最终文件清单 ===\"; ls -la \"一人公司OPC完全指南_合订本.md\" merge_opc.py"
