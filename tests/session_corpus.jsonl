"cat > /tmp/pdfpos.py << 'EOF'\nimport zlib, re, sys\n\ndata = open('attachments/谢先生简历.pdf','rb').read()\n\n# find all streams\nstreams = []\nfor m in re.finditer(rb'stream\\r?\\n', data):\n    start = m.end()\n    end = data.find(b'endstream', start)\n    if end == -1: continue\n    streams.append(data[start:end].rstrip(b'\\r\\n'))\n\ndef decode(s):\n    try:\n        return zlib.decompress(s)\n    except Exception:\n        return s\n\n# find the content stream (contains Tj/TJ operators and 'BT')\ncand = None\nfor s in streams:\n    d = decode(s)\n    if b'BT' in d and (b'Tj' in d or b'TJ' in d) and len(d) > 500:\n        cand = d\n        break\n\nif cand is None:\n    print(\"NO CONTENT STREAM FOUND\")\n    sys.exit(1)\n\ntext = cand.decode('latin-1')\n\n# Extract text with positions: track current matrix via Tm/Td and text via Tj/TJ\n# We'll parse tokens in order, maintaining font size and position.\ntokens = re.findall(rb'(?:\\[(?:[^\\]])*\\])|(?:\\([^)]*\\))|(?:<<[^>]*>>)|/[A-Za-z0-9]+|(?:[A-Za-z0-9]+(?:\\.[0-9]+)?)|[A-Za-z]+', cand)\n\n# simpler: use regex over decoded bytes with latin-1 decode for position tracking\nimport re as re2\nops = re2.findall(r'BT|ET|Tf|Td|TD|Tm|Tj|TJ|\\d+\\.?\\d*|\\-?\\d+\\.?\\d*|\\((?:\\\\.|[^)])*\\)|\\[[^\\]]*\\]', text)\n\nitems = []\n# font size\nfs = 10\ncur_x = cur_y = 0\ni = 0\nwhile i < len(ops):\n    op = ops[i]\n    if op == 'BT':\n        pass\n    elif op == 'ET':\n        pass\n    elif op == 'Tf':\n        # previous tokens: size\n        if i >= 1:\n            try: fs = float(ops[i-1])\n            except: pass\n    elif op in ('Td','TD'):\n        try:\n            tx = float(ops[i-1]); ty = float(ops[i-2])\n            cur_x += tx; cur_y += ty\n        except: pass\n    elif op == 'Tm':\n        # six numbers before: a b c d e f ; e,f are x,y\n        try:\n            a,b,c,d,e,f = [float(ops[i-6]),float(ops[i-5]),float(ops[i-4]),float(ops[i-3]),float(ops[i-2]),float(ops[i-1])]\n            cur_x = e; cur_y = f\n        except: pass\n    elif op == 'Tj':\n        # text in ops[i-1] as (...) - find the previous string\n        j = i-1\n        while j >= 0 and not ops[j].startswith('('):\n            j -= 1\n        if j >= 0:\n            s = ops[j][1:-1]\n            s = s.replace(r'\\(','(').replace(r'\\)',')')\n            items.append((cur_x, cur_y, fs, s))\n            cur_x += 0  # advances but we only care position\n    elif op == 'TJ':\n        j = i-1\n        while j >= 0 and not ops[j].startswith('['):\n            j -= 1\n        if j >= 0:\n            parts = re2.findall(r'\\((?:\\\\.|[^)])*\\)', ops[j])\n            s = ''.join(p[1:-1] for p in parts)\n            s = s.replace(r'\\(','(').replace(r'\\)',')')\n            items.append((cur_x, cur_y, fs, s))\n    i += 1\n\n# group by y (rounded) and sort\nfrom collections import defaultdict\nrows = defaultdict(list)\nfor x,y,fs,s in items:\n    rows[round(y/3)].append((x, fs, s))\n\nout = []\nfor y in sorted(rows, reverse=True):\n    line = ''.join(t[2] for t in sorted(rows[y]))\n    out.append(line)\n\nsys.stdout.write('\\n'.join(out))\nEOF\npython3 /tmp/pdfpos.py > /tmp/resume_pos.txt 2>&1; wc -l /tmp/resume_pos.txt; head -60 /tmp/resume_pos.txt"
