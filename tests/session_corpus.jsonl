"python3 - << 'EOF'\nimport json\ndata = open('.aacode/sessions/session_1786520776_e00df541.json', encoding='utf-8').read()\nprint(\"size:\", len(data))\ntry:\n    obj = json.loads(data)\n    print(\"json OK, top-level type:\", type(obj).__name__)\n    if isinstance(obj, dict):\n        print(\"keys:\", list(obj.keys())[:20])\n    elif isinstance(obj, list):\n        print(\"items:\", len(obj))\n        if obj: print(\"first item keys:\", list(obj[0].keys()) if isinstance(obj[0], dict) else obj[0])\nexcept Exception as e:\n    print(\"json parse err:\", e)\n    print(data[:500])\nEOF"
"python3 - << 'EOF'\nimport json, datetime\nobj = json.load(open('.aacode/sessions/session_1786520776_e00df541.json', encoding='utf-8'))\nprint(\"session_id:\", obj.get('session_id'))\nprint(\"created_at:\", obj.get('created_at'))\nmsgs = obj.get('messages', [])\nprint(\"messages:\", len(msgs))\n# 确认包含 PDF 简历任务\nroles = {}\nfor m in msgs:\n    roles[m.get('role','?')] = roles.get(m.get('role','?'), 0) + 1\nprint(\"roles:\", roles)\n# 找第一条和最后一条消息内容预览\ndef preview(m):\n    c = m.get('content', '')\n    if isinstance(c, str): return c[:80]\n    if isinstance(c, list):\n        parts = []\n        for it in c:\n            if isinstance(it, dict):\n                parts.append(it.get('text','')[:60] if it.get('type')=='text' else f\"<{it.get('type')}>\")\n        return ' | '.join(parts)[:80]\n    return str(c)[:80]\nif msgs:\n    print(\"--- first msg ---\")\n    print(preview(msgs[0]))\n    print(\"--- last msg ---\")\n    print(preview(msgs[-1]))\nEOF"
"python3 - << 'EOF'\nimport shutil, os, json, datetime\nsrc = '.aacode/sessions/session_1786520776_e00df541.json'\ndst = 'session_pdf简历_export.json'\nshutil.copy(src, dst)\nprint(\"copied ->\", dst)\nsz = os.path.getsize(dst)\nprint(\"size:\", sz, \"bytes\")\n# 验证可解析且内容完整\nobj = json.load(open(dst, encoding='utf-8'))\nmsgs = obj['messages']\nprint(\"json valid, messages:\", len(msgs))\nprint(\"session_id:\", obj['session_id'])\nprint(\"created:\", datetime.datetime.fromtimestamp(obj['created_at']))\n# 快速统计文本量\ntotal_chars = 0\nfor m in msgs:\n    c = m.get('content','')\n    if isinstance(c, str): total_chars += len(c)\n    elif isinstance(c, list):\n        for it in c:\n            if isinstance(it, dict) and it.get('type')=='text':\n                total_chars += len(it.get('text',''))\nprint(\"total text chars:\", total_chars)\nEOF"
