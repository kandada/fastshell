"cat > merge_opc.py << 'PY'\n# merge_opc.py — 将多份 OPC 文档合并为一个合订本，原文档保持不动\nimport re, io\n\nSOURCES = [\n    (\"第一篇　认知篇：OPC 全面资料\",           \"OPC一人公司资料汇总.md\"),\n    (\"第二篇　实操篇：从 0 到 1 落地\",          \"OPC一人公司创业实操指南.md\"),\n    (\"第三篇　对比篇：一人公司 / 普通公司 / 个体户\", \"一人公司_普通公司_个体户_区别与优势.md\"),\n]\nOUT = \"一人公司OPC完全指南_合订本.md\"\n\ndef load_body(path):\n    \"\"\"读取文件，取出标题，剔除导航行，正文标题降一级\"\"\"\n    with io.open(path, encoding=\"utf-8\") as f:\n        lines = f.read().splitlines()\n    title, body = None, []\n    for ln in lines:\n        if title is None and ln.startswith(\"# \"):\n            title = ln[2:].strip()\n            continue\n        # 剔除指向系列文档的导航行（合订后已无必要）\n        if \"相关系列文档\" in ln:\n            continue\n        body.append(ln)\n    # 标题降一级：# -> ##，## -> ### ...\n    demoted = []\n    for ln in body:\n        m = re.match(r\"^(#{1,6})(\\s)\", ln)\n        if m:\n            demoted.append(\"#\" + ln)\n        else:\n            demoted.append(ln)\n    return title, \"\\n\".join(demoted).strip()\n\nparts = []\ntoc = []\nfor i, (part_title, path) in enumerate(SOURCES, 1):\n    title, body = load_body(path)\n    toc.append(\"| %d | %s | `%s` |\" % (i, part_title, path))\n    parts.append((part_title, path, title, body))\n\nhead = []\nhead.append(\"# 一人公司 OPC 完全指南（合订本）\")\nhead.append(\"\")\nhead.append(\"> 本合订本由以下 3 份文档**合并整理**而成，内容忠实保留原文，**原始文档保持不动**。\")\nhead.append(\"> \")\nhead.append(\"> 合并时间：由脚本 `merge_opc.py` 自动生成。\")\nhead.append(\"\")\nhead.append(\"---\")\nhead.append(\"\")\nhead.append(\"## 目录\")\nhead.append(\"\")\nhead.append(\"| 篇 | 内容 | 原文档 |\")\nhead.append(\"|----|------|--------|\")\nhead.extend(toc)\nhead.append(\"\")\nhead.append(\"> 📌 阅读指引：**第 1 篇**建立认知（定义/历程/政策/风险/趋势）；**第 2 篇**讲落地（注册/补贴/避坑）；**第 3 篇**做主体选择（一人公司 / 普通公司 / 个体户对比）。\")\nhead.append(\"\")\nhead.append(\"---\")\nhead.append(\"\")\n\nchunks = [\"\\n\".join(head)]\nfor part_title, path, title, body in parts:\n    chunk = []\n    chunk.append(\"## \" + part_title)\n    chunk.append(\"\")\n    chunk.append(\"*（原文档：`%s`　原标题：%s）*\" % (path, title))\n    chunk.append(\"\")\n    chunk.append(body)\n    chunk.append(\"\")\n    chunk.append(\"---\")\n    chunk.append(\"\")\n    chunks.append(\"\\n\".join(chunk))\n\nout = \"\\n\".join(chunks)\nout = re.sub(r\"\\n{4,}\", \"\\n\\n\\n\", out).rstrip() + \"\\n\"\nwith io.open(OUT, \"w\", encoding=\"utf-8\") as f:\n    f.write(out)\nprint(\"已生成:\", OUT)\nprint(\"字符数:\", len(out), \"行数:\", out.count(\"\\n\")+1)\nPY\npython3 merge_opc.py"
