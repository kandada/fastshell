"cat > pos.py << 'EOF'\nimport zlib, re\nS = ''.join(open('resume_text.txt', encoding='utf-8').read().split())\nprint(\"total chars:\", len(S))\n\ndata = open('attachments/谢先生简历.pdf','rb').read()\nstreams = []\nfor m in re.finditer(rb'stream\\r?\\n', data):\n    start = m.end()\n    end = data.find(b'endstream', start)\n    if end == -1: continue\n    streams.append(data[start:end].rstrip(b'\\r\\n'))\nd = None\nfor s in streams:\n    try: dd = zlib.decompress(s)\n    except Exception: dd = s\n    if b'BT' in dd and (b'Tj' in dd or b'TJ' in dd) and len(dd)>20000:\n        d = dd; break\ntxt = d.decode('latin-1')\n\ntoks = re.findall(r'BT|ET|Tf|Td|TD|Tm|Tj|TJ|\\-?\\d+\\.?\\d*|<[0-9A-Fa-f]+>|\\[[^\\]]*\\]', txt)\n\ndef codes_of(h):\n    h = h[1:-1]\n    # determine code width: try 4-digit codes; if len%4!=0 use 2-digit\n    if len(h) % 4 == 0:\n        return [h[i:i+4] for i in range(0, len(h), 4)]\n    return [h[i:i+2] for i in range(0, len(h), 2)]\n\nglyphs = []  # (x, y)\ncur_x, cur_y = 0.0, 0.0\ni = 0; n = len(toks)\nwhile i < n:\n    t = toks[i]\n    if t == 'Tm':\n        try:\n            e = float(toks[i-2]); f = float(toks[i-1])\n            cur_x, cur_y = e, f\n        except Exception: pass\n    elif t in ('Td','TD'):\n        try:\n            tx = float(toks[i-1]); ty = float(toks[i-2])\n            cur_x += tx; cur_y += ty\n        except Exception: pass\n    elif t == 'Tj':\n        j = i-1\n        while j >= 0 and not toks[j].startswith('<'):\n            j -= 1\n        if j >= 0 and toks[j].startswith('<'):\n            for c in codes_of(toks[j]):\n                glyphs.append((cur_x, cur_y))\n    elif t == 'TJ':\n        j = i-1\n        while j >= 0 and not toks[j].startswith('['):\n            j -= 1\n        if j >= 0:\n            for h in re.findall(r'<[0-9A-Fa-f]+>', toks[j]):\n                for c in codes_of(h):\n                    glyphs.append((cur_x, cur_y))\n    i += 1\n\nprint(\"glyphs:\", len(glyphs), \"chars:\", len(S))\n\nfrom collections import defaultdict\nrows = defaultdict(list)\nfor idx,(x,y) in enumerate(glyphs):\n    if idx >= len(S): break\n    rows[round(y)].append((x, S[idx]))\n\nout = []\nfor y in sorted(rows, reverse=True):\n    line = ''.join(ch for _, ch in sorted(rows[y]))\n    out.append((y, line))\nfor y, line in out:\n    print(\"%4d %s\" % (y, line))\nEOF\npython3 pos.py > layout.txt 2>&1; head -5 layout.txt; echo ...; grep -n \"至 今\\|至今\\|2 0 1\\|2015\\|2019\\|2018\\|2021\" layout.txt | head -30"
