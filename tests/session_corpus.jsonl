"cd /projects/test0723\npython3 - << 'PY'\nimport struct, os\nbase='images'\ndef jpeg_size(path):\n    data=open(path,'rb').read()\n    if data[:2]!=b'\\xff\\xd8': return 'NOT-JPEG'\n    i=2\n    while i < len(data)-9:\n        if data[i]!=0xFF: i+=1; continue\n        m=data[i+1]\n        if m in (0xC0,0xC1,0xC2,0xC3,0xC5,0xC6,0xC7,0xC9,0xCA,0xCB,0xCD,0xCE,0xCF):\n            h=struct.unpack('>H',data[i+5:i+7])[0]; w=struct.unpack('>H',data[i+7:i+9])[0]\n            return (w,h)\n        i+=2+struct.unpack('>H',data[i+2:i+4])[0]\n    return None\nfor f in sorted(os.listdir(base)):\n    p=os.path.join(base,f)\n    if os.path.isfile(p):\n        print(f, os.path.getsize(p), 'bytes', jpeg_size(p))\nPY"
"for g in 89AB0A6D8C9C1744 CD92523C3BF38B8E C6924952C1E67E89 B8940F91FD513366 D1163B5BAB589BD1 71AC689C666C9EC7 583B9E062BEF72E1 90AD20064D2E3A1D; do\n  echo \"== $g\"\n  curl -s -A \"Mozilla/5.0\" \"https://ppbc.iplant.cn/tu/$g\" | grep -oE \"拍摄[^<]{0,40}|PPBC id:[0-9]+|像素[ ]?[0-9]+ x [0-9]+\" | head -5\ndone"
"cd /projects/test0723\npython3 - << 'PY'\nimport io\np='huangguzi.md'\ns=open(p,encoding='utf-8').read()\n\n# 1) update title\ns=s.replace('# 黄谷子（谷子 / 粟）—— 百度百科植物资料整理',\n            '# 黄谷子（谷子 / 粟 / 粱 Setaria italica）—— 百度百科 + PPBC 植物资料整理',1)\n\n# 2) add PPBC source line after the baike source line\nold_src='> **资料来源**：百度百科 - 粟（禾本科狗尾草属植物） https://baike.baidu.com/item/粟/354868'\nnew_src=(old_src+'\\n'\n '> **补充资料**：PPBC 中国植物图像库（中科院植物研究所） https://ppbc.iplant.cn/sp/36599')\ns=s.replace(old_src,new_src,1)\n\n# 3) build new section\nsection = '''\n\n---\n\n## 九、PPBC 中国植物图像库资料\n\n**PPBC（Plant Photo Bank of China，中国植物图像库）** 由中国科学院植物研究所于 2008 年设立，是中国最权威的植物图片管理机构之一。\n\n| 项目 | 内容 |\n|---|---|\n| PPBC 物种页 | https://ppbc.iplant.cn/sp/36599 |\n| PPBC 分类层级 | 被子植物 Angiospermae » 禾本科 Poaceae » 狗尾草属 Setaria » 粱 *Setaria italica* |\n| 接受名（PPBC） | 粱 *Setaria italica* (L.) P. Beauv. |\n| 图库收录 | 共 **903 张**图片（截至整理时） |\n| 常见拍摄地 | 陕西（咸阳、延安、榆林）、甘肃（白银、会宁）、北京（延庆）等 |\n\n### 图片欣赏（来源：PPBC 中国植物图像库）\n\n![谷子/粟 图1](images/huangguzi_1.jpg)\n\n*图1：朱仁斌 摄 · 陕西省咸阳市杨凌区（PPBC id 6007367，2009/7/18）*\n\n![谷子/粟 图2](images/huangguzi_2.jpg)\n\n*图2：朱仁斌 摄 · 陕西省延安市（PPBC id 5976602）*\n\n![谷子/粟 图3](images/huangguzi_3.jpg)\n\n*图3：朱仁斌 摄 · 陕西省延安市（PPBC id 5976589）*\n\n![谷子/粟 图4](images/huangguzi_4.jpg)\n\n*图4：李垚 摄 · 甘肃省白银市会宁县（PPBC id 4878984）*\n\n![谷子/粟 图5](images/huangguzi_5.jpg)\n\n*图5：陈之欢 摄 · 北京市延庆区帮水峪（PPBC id 5683470，2019/9/3）*\n\n![谷子/粟 图6](images/huangguzi_6.jpg)\n\n*图6：朱仁斌 摄 · 陕西省咸阳市杨凌区（PPBC id 6007366，2009/7/18）*\n\n> **图片来源说明**：以上图片下载自 PPBC 中国植物图像库（https://ppbc.iplant.cn/sp/36599），版权归原作者及 PPBC 所有，仅供学习参考，请勿用于商业用途或去除水印。\n'''\n\nmarker='\\n> **备注**：本文档依据百度百科'\nassert marker in s, 'marker not found'\ns=s.replace(marker, section+marker,1)\n\nopen(p,'w',encoding='utf-8').write(s)\nprint('OK, new length', len(s))\n\n# verify\nimport re\nprint('sections:', [l for l in s.splitlines() if l.startswith('## ')])\nprint('images referenced:', re.findall(r'!\\[.*?\\]\\((.*?)\\)', s))\nPY"
