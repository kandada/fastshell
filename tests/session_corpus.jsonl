"python3 - << 'EOF'\nimport zlib, re, subprocess\n\n# 1) readable text from pdftotext, as a flat char sequence (one char per glyph)\nout = subprocess.run(['pdftotext','attachments/谢先生简历.pdf','-'], capture_output=True, text=True).stdout\nS = ''.join(out.split())\nprint(\"total chars:\", len(S))\n\n# 2) parse content stream, collect glyph runs with positions in order\ndata = open('attachments/谢先生简历.pdf','rb').read()\nstreams = []\nfor m in re.finditer(rb'stream\\r?\\n', data):\n    start = m.end()\n    end = data.find(b'endstream', start)\n    if end == -1: continue\n    streams.append(data[start:end].rstrip(b'\\r\\n'))\nd = None\nfor s in streams:\n    try: dd = zlib.decompress(s)\n    except Exception: dd = s\n    if b'BT' in dd and (b'Tj' in dd or b'TJ' in dd) and len(dd)>20000:\n        d = dd; break\ntxt = d.decode('latin-1')\n\ntoks = re.findall(r'BT|ET|/F\\d+|/C\\d+|Tf|Td|TD|Tm|Tj|TJ|\\-?\\d+\\.?\\d*|<[0-9A-Fa-f]+>|\\[[^\\]]*\\]', txt)\n\nglyphs = []  # (x, y)\ncur_x, cur_y = 0.0, 0.0\ni = 0\nn = len(toks)\nwhile i < n:\n    t = toks[i]\n    if t == 'Tm':\n        try:\n            e = float(toks[i-2]); f = float(toks[i-1])\n            cur_x, cur_y = e, f\n        except Exception: pass\n    elif t in ('Td','TD'):\n        try:\n            tx = float(toks[i-1]); ty = float(toks[i-2])\n            cur_x += tx; cur_y += ty\n        except Exception: pass\n    elif t == 'Tj':\n        j = i-1\n        while j >= 0 and not toks[j].startswith('<'):\n            j -= 1\n        if j >= 0 and toks[j].startswith('<') and len(toks[j]) >= 4:\n            glyphs.append((cur_x, cur_y))\n            # advance x by unknown width; use gap detection later\n    elif t == 'TJ':\n        j = i-1\n        while j >= 0 and not toks[j].startswith('['):\n            j -= 1\n        if j >= 0:\n            hs = re.findall(r'<[0-9A-Fa-f]+>', toks[j])\n            for h in hs:\n                glyphs.append((cur_x, cur_y))\n    i += 1\n\nprint(\"glyphs found:\", len(glyphs))\nif len(glyphs) != len(S):\n    print(\"WARN: mismatch, truncating to min:\", min(len(glyphs), len(S)))\n\n# 3) reconstruct lines: group by y\nfrom collections import defaultdict\nrows = defaultdict(list)\nfor idx, (x,y) in enumerate(glyphs):\n    if idx >= len(S): break\n    rows[round(y/3)].append((x, S[idx]))\n\nfor y in sorted(rows, reverse=True):\n    line = ''.join(ch for _, ch in sorted(rows[y]))\n    print(y, line)\nEOF"
