"cd /data/user/0/com.xiefujin.aacode/files/fastshell/projects/test1\npython3 - <<'PY'\nimport struct, os\ndef jpeg_size(path):\n    with open(path,'rb') as f:\n        data=f.read()\n    if data[:2]!=b'\\xff\\xd8': return None\n    i=2\n    while i < len(data):\n        if data[i]!=0xFF: i+=1; continue\n        marker=data[i+1]\n        if marker in (0xC0,0xC1,0xC2,0xC3,0xC5,0xC6,0xC7,0xC9,0xCA,0xCB,0xCD,0xCE,0xCF):\n            h,w=struct.unpack('>HH',data[i+5:i+9])\n            return w,h\n        if marker in (0xD8,0xD9) or 0xD0<=marker<=0xD7: i+=2; continue\n        seglen=struct.unpack('>H',data[i+2:i+4])[0]\n        i+=2+seglen\n    return None\nfor f in sorted(os.listdir('data/images')):\n    p=os.path.join('data/images',f)\n    print(f, jpeg_size(p), os.path.getsize(p),'bytes')\nPY"
