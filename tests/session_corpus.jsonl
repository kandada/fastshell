"cd /var/mobile/Containers/Data/Application/72FD3684-4F96-4636-92A3-244BDB36AA96/Documents/fastshell/projects/Test1 && python3 -c \"\nimport struct, glob, os\ndef jpeg_size(d):\n    if d[:2]!=b'\\xff\\xd8': return None\n    i=2\n    while i<len(d)-9:\n        if d[i]!=0xFF: i+=1; continue\n        m=d[i+1]\n        if m in (0xC0,0xC1,0xC2,0xC3):\n            return struct.unpack('>H',d[i+7:i+9])[0], struct.unpack('>H',d[i+5:i+7])[0]\n        if m in (0xD8,0xD9) or 0xD0<=m<=0xD7: i+=2; continue\n        i+=2+struct.unpack('>H',d[i+2:i+4])[0]\n    return None\ntot=0\nfor f in sorted(glob.glob('phalaenopsis/*.jpg')):\n    d=open(f,'rb').read(); sz=jpeg_size(d); tot+=len(d)\n    print(os.path.basename(f), 'JPEG' if d[:2]==b'\\xff\\xd8' else 'BAD', sz, f'{len(d)} bytes')\nprint('total', len(glob.glob('phalaenopsis/*.jpg')), 'files,', round(tot/1024/1024,2), 'MB')\n\""
"cd /var/mobile/Containers/Data/Application/72FD3684-4F96-4636-92A3-244BDB36AA96/Documents/fastshell/projects/Test1 && cat > phalaenopsis/SOURCE.md << 'EOF'\n# 蝴蝶兰 Phalaenopsis aphrodite — 图片来源：PPBC 中国植物图像库\n\n- 物种页面: https://ppbc.iplant.cn/sp/219751  （学名: Phalaenopsis aphrodite Rchb. f.）\n- 科属: 兰科 Orchidaceae >> 蝴蝶兰属 Phalaenopsis\n- 图库记录总数: 6528 张\n- 图片列表接口: https://ppbc.iplant.cn/ashx/getphotopage.ashx?n=1&group=sp&cid=219751&p=&m=\n- 高清图片地址规则: https://img{N}.iplant.cn/image61/b/{HASH}.jpg （1080x720，需带 Referer: https://ppbc.iplant.cn/）\n- 缩略图地址规则: https://img{N}.iplant.cn/image2/236/{HASH}.jpg （236x157）\n\n## 已下载图片 (image61/b, 约 1080x720)\n| 文件 | 图片ID | 详情页 |\n|------|--------|--------|\n| Phalaenopsis_1208333.jpg | 1208333 | https://ppbc.iplant.cn/tu/1208333 |\n| Phalaenopsis_1208335.jpg | 1208335 | https://ppbc.iplant.cn/tu/1208335 |\n| Phalaenopsis_1560664.jpg | 1560664 | https://ppbc.iplant.cn/tu/1560664 |\n| Phalaenopsis_162473.jpg  | 162473  | https://ppbc.iplant.cn/tu/162473  |\n| Phalaenopsis_3366407.jpg | 3366407 | https://ppbc.iplant.cn/tu/3366407 |\n| Phalaenopsis_347706.jpg  | 347706  | https://ppbc.iplant.cn/tu/347706  |\n| Phalaenopsis_804760.jpg  | 804760  | https://ppbc.iplant.cn/tu/804760  |\n| Phalaenopsis_804761.jpg  | 804761  | https://ppbc.iplant.cn/tu/804761  |\n\n> 版权归原作者所有，仅供学习研究使用。\nEOF\nrm -f t236.jpg tbig.jpg t2.bin t2resp.bin pbe236.jpg tmp.bin ja.js ppbc_search.html tu.html tu1.html autoajax.js indexsp.js windowjs.js publicjs.js eniviewer.js headers.txt\necho '--- final tree ---'; find phalaenopsis -type f | sort; echo; ls -l *.py *.json *.txt 2>/dev/null"
