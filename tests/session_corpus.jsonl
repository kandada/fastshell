"cat > extract.py << 'EOF'\n# extract.py\nimport html.parser, re\n\nclass TextExtractor(html.parser.HTMLParser):\n    def __init__(self):\n        super().__init__()\n        self.parts = []\n        self.skip = 0\n        self.in_script = False\n        self.in_style = False\n    def handle_starttag(self, tag, attrs):\n        a = dict(attrs)\n        cls = a.get('class', '') or ''\n        if tag in ('script', 'style'):\n            self.in_script = True\n        if 'lemma-summary' in cls or 'J-lemma-content' in cls or 'basic-info' in cls or 'album' in cls or 'J-summary' in cls:\n            self.skip += 1\n        if tag in ('p', 'div', 'h1', 'h2', 'h3', 'br', 'li'):\n            self.parts.append('\\n')\n    def handle_endtag(self, tag):\n        if tag in ('script', 'style'):\n            self.in_script = False\n        if tag in ('p', 'div', 'h1', 'h2', 'h3', 'li'):\n            self.parts.append('\\n')\n    def handle_data(self, data):\n        if not self.in_script and not self.in_style:\n            self.parts.append(data)\n\nhtml_text = open('budgie.html', encoding='utf-8', errors='ignore').read()\n# 去掉注释\nhtml_text = re.sub(r'<!--.*?-->', '', html_text, flags=re.S)\np = TextExtractor()\np.feed(html_text)\ntext = ''.join(p.parts)\nlines = [l.strip() for l in text.split('\\n')]\nlines = [l for l in lines if l]\nout = '\\n'.join(lines)\nopen('budgie.txt', 'w', encoding='utf-8').write(out)\nprint('总字符数:', len(out))\nprint('前1500字符:')\nprint(out[:1500])\nEOF\npython3 extract.py"
