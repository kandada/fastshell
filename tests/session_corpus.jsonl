"# Try common description endpoints\nfor ep in getspdesc.ashx getsptext.ashx spdesc.ashx getspc.ashx getspinfo.ashx getspcount.ashx getphotosbycid.ashx getphotos.ashx getphotobycid.ashx getphotobyspid.ashx getphotosbysp.ashx getphotobyspec.ashx; do\n  resp=$(curl -sL \"http://ppbc.iplant.cn/ashx/$ep?cid=29482&t=$(date +%s)\" -A \"Mozilla/5.0\" --max-time 5 2>/dev/null | head -c 100)\n  if [[ \"$resp\" != *\"<title>404\"* ]] && [[ \"$resp\" != *\"<title>���� 404\"* ]]; then\n    echo \"FOUND: $ep -> $resp\"\n  fi\ndone\necho \"===\"\n# Try classspsearch.ashx with spmode\ncurl -sL \"http://ppbc.iplant.cn/ashx/classspsearch.ashx?key=丁香罗勒&t=$(date +%s)\" -A \"Mozilla/5.0\" -w \"\\nHTTP=%{http_code}\\n\" 2>/dev/null | head -c 2000"
