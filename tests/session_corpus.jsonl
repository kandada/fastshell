"# Use proper headers and force fresh download\nDIR=/var/mobile/Containers/Data/Application/36B9F6AF-4B0A-4C57-A3E3-846217E6D0BD/Documents/fastshell/projects/Test1/ppbc_丁香罗勒\nmkdir -p \"$DIR\"\n\n# Download with -H 'Accept: image/webp,*/*' to test, and check\nfor i in 1 2 3 4; do\n  case $i in\n    1) URL=\"https://img2.iplant.cn/image2/155/33BCF56261CA3EA9.jpg\"; NAME=\"01_丁香罗勒_33BCF56261CA3EA9.jpg\";;\n    2) URL=\"https://img2.iplant.cn/image2/i/ABA5C6BAA69262B7.jpg\"; NAME=\"02_丁香罗勒_ABA5C6BAA69262B7.jpg\";;\n    3) URL=\"https://img4.iplant.cn/image2/i/26A5B5021C3B515B.jpg\"; NAME=\"03_丁香罗勒_26A5B5021C3B515B.jpg\";;\n    4) URL=\"https://img5.iplant.cn/image2/i/0A232B70A49B62582C54048389F8F44A.jpg\"; NAME=\"04_丁香罗勒_0A232B70A49B62582C54048389F8F44A.jpg\";;\n  esac\n  echo \"=== Downloading $NAME from $URL ===\"\n  curl -sL -H \"Referer: http://ppbc.iplant.cn/sp/29482\" -H \"Accept: image/avif,image/webp,image/apng,image/svg+xml,image/*,*/*;q=0.8\" \\\n    -A \"Mozilla/5.0 (iPhone; CPU iPhone OS 17_0 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/17.0 Mobile/15E148 Safari/604.1\" \\\n    \"$URL\" -o \"$DIR/$NAME\" -w \"  HTTP=%{http_code} size=%{size_download} type=%{content_type}\\n\"\ndone\necho \"\"\necho \"=== Checksums ===\"\npython3 -c \"\nimport os, hashlib\nd = '/var/mobile/Containers/Data/Application/36B9F6AF-4B0A-4C57-A3E3-846217E6D0BD/Documents/fastshell/projects/Test1/ppbc_丁香罗勒'\nfor f in sorted(os.listdir(d)):\n    p = os.path.join(d, f)\n    with open(p, 'rb') as fh:\n        h = hashlib.md5(fh.read()).hexdigest()\n    print(f'{f}: size={os.path.getsize(p)} md5={h[:16]}')\n\""
"DIR=/var/mobile/Containers/Data/Application/36B9F6AF-4B0A-4C57-A3E3-846217E6D0BD/Documents/fastshell/projects/Test1/ppbc_丁香罗勒\npython3 <<'PYEOF'\nimport os, hashlib, urllib.request\n\nDIR = '/var/mobile/Containers/Data/Application/36B9F6AF-4B0A-4C57-A3E3-846217E6D0BD/Documents/fastshell/projects/Test1/ppbc_丁香罗勒'\nos.makedirs(DIR, exist_ok=True)\n\nurls = [\n    ('https://img2.iplant.cn/image2/155/33BCF56261CA3EA9.jpg', '01_丁香罗勒_33BCF56261CA3EA9.jpg'),\n    ('https://img2.iplant.cn/image2/i/ABA5C6BAA69262B7.jpg', '02_丁香罗勒_ABA5C6BAA69262B7.jpg'),\n    ('https://img4.iplant.cn/image2/i/26A5B5021C3B515B.jpg', '03_丁香罗勒_26A5B5021C3B515B.jpg'),\n    ('https://img5.iplant.cn/image2/i/0A232B70A49B62582C54048389F8F44A.jpg', '04_丁香罗勒_0A232B70A49B62582C54048389F8F44A.jpg'),\n]\n\nhdrs = {\n    'User-Agent': 'Mozilla/5.0 (iPhone; CPU iPhone OS 17_0 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/17.0 Mobile/15E148 Safari/604.1',\n    'Referer': 'http://ppbc.iplant.cn/sp/29482',\n    'Accept': 'image/avif,image/webp,image/apng,image/svg+xml,image/*,*/*;q=0.8',\n}\n\nfor url, name in urls:\n    req = urllib.request.Request(url, headers=hdrs)\n    with urllib.request.urlopen(req, timeout=20) as r:\n        data = r.read()\n        path = os.path.join(DIR, name)\n        with open(path, 'wb') as f:\n            f.write(data)\n        print(f'{name}: HTTP={r.status} size={len(data)} type={r.headers.get(\"Content-Type\")} md5={hashlib.md5(data).hexdigest()[:16]}')\n\n# Verify\nprint('\\n=== All files ===')\nfor f in sorted(os.listdir(DIR)):\n    p = os.path.join(DIR, f)\n    with open(p, 'rb') as fh:\n        h = hashlib.md5(fh.read()).hexdigest()\n    print(f'{f}: size={os.path.getsize(p)} md5={h[:16]}')\nPYEOF"
