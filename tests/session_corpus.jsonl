"cd .cache\n# 拉多个 lid 的样本，提取每个 lid 的第一条标题\nfor lid in 2513 2514 2515 2517 2671 2672 1686 1687 1688 1689 1690 1691 1692 1693 1694 1695 1696 1697 1698 2518 2519; do\n  curl -s -A \"Mozilla/5.0\" \"https://feed.mix.sina.com.cn/api/roll/get?pageid=153&lid=${lid}&num=2&page=1\" -o \"r_${lid}.json\"\n  # 提取第一条 title 与 ctime\n  title=$(grep -o '\"title\":\"[^\"]*\"' \"r_${lid}.json\" | head -1 | sed 's/\"title\":\"//;s/\"$//')\n  ct=$(grep -o '\"ctime\":[0-9]*' \"r_${lid}.json\" | head -1 | sed 's/\"ctime\"://')\n  if [ -n \"$title\" ]; then\n    # 转换时间戳(假设秒)\n    if [ -n \"$ct\" ] && [ \"$ct\" != \"0\" ]; then\n      dt=$(date -r \"$ct\" \"+%m-%d %H:%M\" 2>/dev/null)\n    else\n      dt=\"?\"\n    fi\n    printf \"lid=%-6s [%s] %s\\n\" \"$lid\" \"$dt\" \"${title:0:60}\"\n  else\n    echo \"lid=$lid (empty or fail)\"\n  fi\ndone\nrm -f r_*.json"
"cat > .cache/probe.sh << 'SHELL'\n#!/bin/bash\ncd .cache\nfor lid in 2513 2514 2515 2517 2671 2672 1686 1687 1688 1689 1690 1691 1692 1693 1694 1695 1696 1697 1698 2518 2519 2520 2521 2522 2523 2524; do\n  curl -s -A 'Mozilla/5.0' \"https://feed.mix.sina.com.cn/api/roll/get?pageid=153&lid=${lid}&num=2&page=1\" -o \"r_${lid}.json\"\n  title=$(grep -o '\"title\":\"[^\"]*\"' \"r_${lid}.json\" 2>/dev/null | head -1 | sed 's/\"title\":\"//;s/\"$//')\n  ct=$(grep -o '\"ctime\":[0-9]*' \"r_${lid}.json\" 2>/dev/null | head -1 | sed 's/\"ctime\"://')\n  if [ -n \"$title\" ]; then\n    dt=\"?\"\n    if [ -n \"$ct\" ] && [ \"$ct\" != \"0\" ]; then\n      dt=$(date -r \"$ct\" \"+%m-%d %H:%M\" 2>/dev/null)\n    fi\n    printf 'lid=%-6s [%s] %s\\n' \"$lid\" \"$dt\" \"${title:0:60}\"\n  fi\ndone\nrm -f r_*.json\nSHELL\nchmod +x .cache/probe.sh && bash .cache/probe.sh"
