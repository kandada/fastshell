"cat > export_session.py << 'EOF'\n# export_session.py\n\"\"\"导出 .aacode 会话记录为 JSON 文件，供调试使用。\"\"\"\nimport json\nimport time\n\nSRC = '.aacode/sessions/session_1786548254_95d60f23.json'\nDST = 'session_export_1786548254_95d60f23.json'\n\ndef main():\n    with open(SRC, 'r', encoding='utf-8') as f:\n        data = json.load(f)\n\n    messages = data['messages']\n\n    # 统计信息\n    role_count = {}\n    for m in messages:\n        role_count[m['role']] = role_count.get(m['role'], 0) + 1\n\n    export = {\n        'export_info': {\n            'source': SRC,\n            'exported_at': int(time.time()),\n            'exported_at_human': time.strftime('%Y-%m-%d %H:%M:%S'),\n            'message_count': len(messages),\n            'role_stats': role_count,\n        },\n        'session': {\n            'session_id': data.get('session_id'),\n            'created_at': data.get('created_at'),\n        },\n        'messages': messages,\n    }\n\n    with open(DST, 'w', encoding='utf-8') as f:\n        json.dump(export, f, ensure_ascii=False, indent=2)\n\n    print(f'导出成功: {DST}')\n    print(f'消息总数: {len(messages)}')\n    print(f'角色统计: {role_count}')\n    print(f'文件大小: {len(json.dumps(export, ensure_ascii=False))} 字节')\n\nif __name__ == '__main__':\n    main()\nEOF\npython3 export_session.py"
