"cat > align.py << 'PYEOF'\nimport zlib, re\np1 = ''.join(open('resume_text.txt', encoding='utf-8').read().split())\n\n# get page-1 only text via pdftotext -f 1\nimport os\nos.system('pdftotext -f 1 -l 1 \"attachments/谢先生简历.pdf\" p1.txt')\nS1 = ''.join(open('p1.txt', encoding='utf-8').read().split())\nprint(\"page1 chars:\", len(S1))\n\ndata = open('attachments/谢先生简历.pdf','rb').read()\nstreams = []\nfor m in re.finditer(rb'stream\\r?\\n', data):\n    start = m.end()\n    end = data.find(b'endstream', start)\n    if end == -1: continue\n    streams.append(data[start:end].rstrip(b'\\r\\n'))\n\ndef codes_of(h):\n    h = h[1:-1]\n    if len(h) % 4 == 0:\n        return [h[i:i+4] for i in range(0, len(h), 4)]\n    return [h[i:i+2] for i in range(0, len(h), 2)]\n\ndef stream_codes(si):\n    s = streams[si]\n    try: d = zlib.decompress(s)\n    except Exception: d = s\n    txt = d.decode('latin-1')\n    toks = re.findall(r'BT|ET|Tf|Td|TD|Tm|Tj|TJ|\\-?\\d+\\.?\\d*|<[0-9A-Fa-f]+>|\\[[^\\]]*\\]', txt)\n    cs = []\n    i = 0; n = len(toks)\n    while i < n:\n        t = toks[i]\n        if t == 'Tj':\n            j = i-1\n            while j >= 0 and not toks[j].startswith('<'):\n                j -= 1\n            if j >= 0 and toks[j].startswith('<'):\n                cs.extend(codes_of(toks[j]))\n        i += 1\n    return cs\n\nfor si in (12, 14):\n    cs = stream_codes(si)\n    # try aligning cs to S1 and to S2 (full minus S1 attempt) with offsets\n    best = None\n    for off in range(0, 300):\n        conflicts = 0; total = 0\n        for k, c in enumerate(cs):\n            idx = off + k\n            if idx >= len(S1): break\n            ch = S1[idx]\n            total += 1\n            if ch == ' ': continue\n        # just count mismatches for off=0 quickly\n    # report conflicts at off=0 (first len)\n    conflicts = 0; ntest = min(len(cs), len(S1))\n    cmap = {}\n    for k in range(ntest):\n        c, ch = cs[k], S1[k]\n        if c in cmap and cmap[c] != ch:\n            conflicts += 1\n        else:\n            cmap[c] = ch\n    print(\"stream\", si, \"codes:\", len(cs), \"vs S1:\", len(S1), \"conflicts@0:\", conflicts, \"unique:\", len(cmap))\nPYEOF\npython3 align.py"
"pdftotext -f 1 -l 1 \"attachments/谢先生简历.pdf\" - | cat > p1.txt; wc -c p1.txt; sed -i \"s|os.system('pdftotext -f 1 -l 1.*||\" align.py; python3 align.py"
"cat > final_pos.py << 'PYEOF'\nimport zlib, re\nS = ''.join(open('p1.txt', encoding='utf-8').read().split())\n\ndata = open('attachments/谢先生简历.pdf','rb').read()\nstreams = []\nfor m in re.finditer(rb'stream\\r?\\n', data):\n    start = m.end()\n    end = data.find(b'endstream', start)\n    if end == -1: continue\n    streams.append(data[start:end].rstrip(b'\\r\\n'))\n\ndef codes_of(h):\n    h = h[1:-1]\n    if len(h) % 4 == 0:\n        return [h[i:i+4] for i in range(0, len(h), 4)]\n    return [h[i:i+2] for i in range(0, len(h), 2)]\n\n# collect ALL codes in page order (stream 12 then 14) with their block positions\nblocks = []  # (stream_idx, f, e, [codes])\nfor si in (12, 14):\n    s = streams[si]\n    try: d = zlib.decompress(s)\n    except Exception: d = s\n    txt = d.decode('latin-1')\n    for b in re.findall(r'BT.*?ET', txt, re.S):\n        m = re.search(r'([\\d.\\-]+)\\s+([\\d.\\-]+)\\s+([\\d.\\-]+)\\s+([\\d.\\-]+)\\s+([\\d.\\-]+)\\s+([\\d.\\-]+)\\s+Tm', b)\n        if not m: continue\n        e, f = float(m.group(5)), float(m.group(6))\n        cs = []\n        for h in re.findall(r'<[0-9A-Fa-f]+>', b):\n            cs.extend(codes_of(h))\n        blocks.append((si, f, e, cs))\n\nallcodes = []\nfor _, _, _, cs in blocks:\n    allcodes.extend(cs)\nprint(\"total codes:\", len(allcodes), \"chars:\", len(S))\n\n# build map\ncmap = {}\nconflicts = 0\nfor i, c in enumerate(allcodes):\n    if i >= len(S): break\n    ch = S[i]\n    if c in cmap and cmap[c] != ch:\n        conflicts += 1\n        if conflicts < 5: print(\"CONF\", c, cmap[c], ch)\n    else:\n        cmap[c] = ch\nprint(\"conflicts:\", conflicts, \"unique:\", len(cmap))\n\n# decode blocks, compute device y: stream12: y=841.92-0.24*3.122*f ; stream14: y=841.92-0.24*(3.122*f-3381.48)\ndef dev_y(si, f):\n    if si == 12:\n        return 841.92 - 0.24*3.122*f\n    return 841.92 - 0.24*(3.122*f - 3381.48)\n\nout = []\nfor si, f, e, cs in blocks:\n    text = ''.join(cmap.get(c, '?') for c in cs)\n    if not text: continue\n    out.append((dev_y(si, f), e, si, text))\n\nfor y, e, si, t in sorted(out, key=lambda z: (-z[0], z[1])):\n    print(\"%7.1f [s%d] %s\" % (y, si, t))\nPYEOF\npython3 final_pos.py > page_layout.txt 2>&1\nhead -3 page_layout.txt\necho \"...\"\ngrep -nE \"至今|2006|2012|2014\\.07|2015\\.07|2015\\.07-2016|2021\\.01|2019\\.02|2018\\.07\" page_layout.txt | head -30"
"cat > final_pos2.py << 'PYEOF'\nimport zlib, re\nS = ''.join(open('p1.txt', encoding='utf-8').read().split())\n\ndata = open('attachments/谢先生简历.pdf','rb').read()\nstreams = []\nfor m in re.finditer(rb'stream\\r?\\n', data):\n    start = m.end()\n    end = data.find(b'endstream', start)\n    if end == -1: continue\n    streams.append(data[start:end].rstrip(b'\\r\\n'))\n\ndef codes_of(h):\n    h = h[1:-1]\n    if len(h) % 4 == 0:\n        return [h[i:i+4] for i in range(0, len(h), 4)]\n    return [h[i:i+2] for i in range(0, len(h), 2)]\n\nblocks = []\nfor si in (12, 14):\n    s = streams[si]\n    try: d = zlib.decompress(s)\n    except Exception: d = s\n    txt = d.decode('latin-1')\n    for b in re.findall(r'BT.*?ET', txt, re.S):\n        m = re.search(r'([\\d.\\-]+)\\s+([\\d.\\-]+)\\s+([\\d.\\-]+)\\s+([\\d.\\-]+)\\s+([\\d.\\-]+)\\s+([\\d.\\-]+)\\s+Tm', b)\n        if not m: continue\n        e, f = float(m.group(5)), float(m.group(6))\n        cs = []\n        for h in re.findall(r'<[0-9A-Fa-f]+>', b):\n            cs.extend(codes_of(h))\n        if not cs: continue\n        # device y (page top = large)\n        if si == 12:\n            y = 841.92 - 0.24*3.122*f\n        else:\n            y = 841.92 - 0.24*(3.122*f - 3381.48)\n        blocks.append((y, e, si, cs))\n\n# sort visually: y desc (top first), x asc (left first)\nblocks.sort(key=lambda z: (-z[0], z[1]))\n\nallcodes = []\nfor _, _, _, cs in blocks:\n    allcodes.extend(cs)\nprint(\"codes:\", len(allcodes), \"chars:\", len(S))\n\ncmap = {}\nconflicts = 0\nfor i, c in enumerate(allcodes):\n    if i >= len(S): break\n    ch = S[i]\n    if c in cmap and cmap[c] != ch:\n        conflicts += 1\n    else:\n        cmap[c] = ch\nprint(\"conflicts:\", conflicts, \"unique:\", len(cmap))\n\nfor y, e, si, cs in blocks:\n    text = ''.join(cmap.get(c, '?') for c in cs)\n    print(\"%7.1f [s%d] %s\" % (y, si, text))\nPYEOF\npython3 final_pos2.py"
