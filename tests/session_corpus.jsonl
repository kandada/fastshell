"cd /var/mobile/Containers/Data/Application/72FD3684-4F96-4636-92A3-244BDB36AA96/Documents/fastshell/projects/Test1 && cat > parse_ppbc.py << 'EOF'\n# parse_ppbc.py — parse PPBC getphotopage JSON, extract photo id + image hash\nimport json, base64, re, sys\n\ndef parse(fn):\n    j = json.loads(open(fn, encoding='utf-8').read())\n    html = base64.b64decode(j['retS']).decode('utf-8', 'ignore')\n    # each item: <div class='img' pid='NNN' cno='...'><a href='/tu/NNN'><img ... src='//host/image2/236/HASH.jpg'\n    items = []\n    for m in re.finditer(r\"pid='(\\d+)'[^>]*>\\s*<a href='/tu/(\\d+)'[^>]*>\\s*<img[^>]*src='//([^/]+)/[^/]+/[^/]+/([0-9A-Fa-f]+)\\.jpg'\", html):\n        pid, pid2, host, h = m.groups()\n        items.append((pid, host, h))\n    # dedupe preserving order\n    seen, out = set(), []\n    for it in items:\n        if it[0] not in seen:\n            seen.add(it[0]); out.append(it)\n    return out, j.get('count'), j.get('nextstr','')\n\nif __name__ == '__main__':\n    items, count, nxt = parse(sys.argv[1] if len(sys.argv)>1 else 'page.json')\n    print(\"count:\", count)\n    for pid, host, h in items:\n        print(pid, host, h)\nEOF\npython3 parse_ppbc.py page.json"
