"cat > pos3.py << 'EOF'\nimport zlib, re\nS = ''.join(open('resume_text.txt', encoding='utf-8').read().split())\n\ndata = open('attachments/谢先生简历.pdf','rb').read()\nstreams = []\nfor m in re.finditer(rb'stream\\r?\\n', data):\n    start = m.end()\n    end = data.find(b'endstream', start)\n    if end == -1: continue\n    streams.append(data[start:end].rstrip(b'\\r\\n'))\n\ndef codes_of(h):\n    h = h[1:-1]\n    if len(h) % 4 == 0:\n        return [h[i:i+4] for i in range(0, len(h), 4)]\n    return [h[i:i+2] for i in range(0, len(h), 2)]\n\nall_codes = []\nfor si, s in enumerate(streams):\n    try: d = zlib.decompress(s)\n    except Exception: d = s\n    txt = d.decode('latin-1')\n    if b'BT' not in d or b'Tj' not in d: continue\n    if len(d) < 500: continue\n    toks = re.findall(r'BT|ET|Tf|Td|TD|Tm|Tj|TJ|\\-?\\d+\\.?\\d*|<[0-9A-Fa-f]+>|\\[[^\\]]*\\]', txt)\n    i = 0; n = len(toks)\n    while i < n:\n        t = toks[i]\n        if t == 'Tj':\n            j = i-1\n            while j >= 0 and not toks[j].startswith('<'):\n                j -= 1\n            if j >= 0 and toks[j].startswith('<'):\n                all_codes.extend(codes_of(toks[j]))\n        i += 1\n\nprint(\"codes:\", len(all_codes), \"chars:\", len(S))\ncmap = {}\nconflicts = 0\nfor c, ch in zip(all_codes, S):\n    if c in cmap and cmap[c] != ch:\n        conflicts += 1\n        if conflicts < 8:\n            print(\"CONFLICT\", c, cmap[c], ch)\n    else:\n        cmap[c] = ch\nprint(\"conflicts:\", conflicts, \"unique codes:\", len(cmap))\n\ndef decode_line(cs):\n    return ''.join(cmap.get(c, '?') for c in cs)\n\nfor si in (12, 14, 16):\n    s = streams[si]\n    try: d = zlib.decompress(s)\n    except Exception: d = s\n    txt = d.decode('latin-1')\n    print(\"=== stream\", si, \"===\")\n    blocks = re.findall(r'BT.*?ET', txt, re.S)\n    for b in blocks:\n        m = re.search(r'Tm\\s+([\\d.\\-]+)\\s+([\\d.\\-]+)\\s+([\\d.\\-]+)\\s+([\\d.\\-]+)\\s+([\\d.\\-]+)\\s+([\\d.\\-]+)', b)\n        if not m: continue\n        e, f = float(m.group(5)), float(m.group(6))\n        cs = re.findall(r'<[0-9A-Fa-f]+>', b)\n        line_codes = []\n        for h in cs:\n            line_codes.extend(codes_of(h))\n        print(\"y=%8.1f  %s\" % (f, decode_line(line_codes)))\nEOF\npython3 pos3.py"
"cat > pos4.py << 'EOF'\nimport zlib, re\n\ndata = open('attachments/谢先生简历.pdf','rb').read()\nstreams = []\nfor m in re.finditer(rb'stream\\r?\\n', data):\n    start = m.end()\n    end = data.find(b'endstream', start)\n    if end == -1: continue\n    streams.append(data[start:end].rstrip(b'\\r\\n'))\n\ndef codes_of(h):\n    h = h[1:-1]\n    if len(h) % 4 == 0:\n        return [h[i:i+4] for i in range(0, len(h), 4)]\n    return [h[i:i+2] for i in range(0, len(h), 2)]\n\n# confirmed code->char map from decoded dates + a few knowns\ncmap = {\n '0015':'2','0013':'0','0014':'1','001C':'9','001B':'8','0018':'5',\n '0011':'.','0010':'-','001A':'7','0019':'6','5365':'至','203C':'今',\n '04A2':'谢','2F64':'先','5041':'生','4053':'男','5F25':'|',\n}\ndef decode(cs):\n    return ''.join(cmap.get(c,'?') for c in cs)\n\ndef mmul(m1, m2):\n    a1,b1,c1,d1,e1,f1 = m1\n    a2,b2,c2,d2,e2,f2 = m2\n    return (a1*a2+b1*c2, a1*b2+b1*d2, c1*a2+d1*c2, c1*b2+d1*d2, e1*a2+f1*c2+e2, e1*b2+f1*d2+f2)\n\n# page-level initial transform\nPAGE_CM = (0.23999999, 0, 0, -0.23999999, 0, 841.91998)\n\nresults = []\nfor si in (12, 14, 16):\n    s = streams[si]\n    try: d = zlib.decompress(s)\n    except Exception: d = s\n    txt = d.decode('latin-1')\n    toks = re.findall(r'q|Q|cm|BT|ET|Tf|Td|TD|Tm|Tj|\\-?\\d+\\.?\\d*|<[0-9A-Fa-f]+>|\\[[^\\]]*\\]', txt)\n    stack = [PAGE_CM]\n    ctm = PAGE_CM\n    cur_x, cur_y = 0.0, 0.0\n    i = 0; n = len(toks)\n    while i < n:\n        t = toks[i]\n        if t == 'q':\n            stack.append(ctm)\n        elif t == 'Q':\n            if len(stack) > 1: ctm = stack.pop()\n        elif t == 'cm':\n            try:\n                a,b,c,d,e,f = [float(toks[i-6]),float(toks[i-5]),float(toks[i-4]),float(toks[i-3]),float(toks[i-2]),float(toks[i-1])]\n                ctm = mmul(ctm, (a,b,c,d,e,f))\n            except Exception: pass\n        elif t == 'Tm':\n            try:\n                a,b,c,d,e,f = [float(toks[i-6]),float(toks[i-5]),float(toks[i-4]),float(toks[i-3]),float(toks[i-2]),float(toks[i-1])]\n                tm = (a,b,c,d,e,f)\n                m = mmul(ctm, tm)\n                # text origin (0,0) -> (m[4], m[5]); x advance dir = m[0]\n                cur_x, cur_y = m[4], m[5]\n            except Exception: pass\n        elif t in ('Td','TD'):\n            try:\n                tx = float(toks[i-1]); ty = float(toks[i-2])\n                # in text space; transform to device: add (tx,ty) along text matrix axes\n                m = mmul(ctm, (1,0,0,1,0,0))\n                cur_x += tx * m[0]; cur_y += tx * m[1] + ty\n            except Exception: pass\n        elif t == 'Tj':\n            j = i-1\n            while j >= 0 and not toks[j].startswith('<'):\n                j -= 1\n            if j >= 0 and toks[j].startswith('<'):\n                cs = codes_of(toks[j])\n                for c in cs:\n                    results.append((cur_x, cur_y, c))\n        i += 1\n\n# group into lines by device y (rounded to 1)\nfrom collections import defaultdict\nlines = defaultdict(list)\nfor x, y, c in results:\n    lines[round(y, 1)].append((x, c))\nout = []\nfor y in sorted(lines, reverse=True):\n    line = ''.join(c for _, c in sorted(lines[y]))\n    out.append((y, line))\nfor y, line in out:\n    print(\"%7.1f  %s\" % (y, line))\nEOF\npython3 pos4.py"
"cat > pos5.py << 'EOF'\nimport zlib, re\n\ndata = open('attachments/谢先生简历.pdf','rb').read()\nstreams = []\nfor m in re.finditer(rb'stream\\r?\\n', data):\n    start = m.end()\n    end = data.find(b'endstream', start)\n    if end == -1: continue\n    streams.append(data[start:end].rstrip(b'\\r\\n'))\n\ndef codes_of(h):\n    h = h[1:-1]\n    if len(h) % 4 == 0:\n        return [h[i:i+4] for i in range(0, len(h), 4)]\n    return [h[i:i+2] for i in range(0, len(h), 2)]\n\ncmap = {\n '0015':'2','0013':'0','0014':'1','001C':'9','001B':'8','0018':'5',\n '0011':'.','0010':'-','001A':'7','0019':'6','5365':'至','203C':'今',\n '04A2':'谢','2F64':'先','5041':'生','4053':'男','5F25':'|',\n}\ndef decode(cs):\n    return ''.join(cmap.get(c,'?') for c in cs)\n\nfor si in (12, 14, 16):\n    s = streams[si]\n    try: d = zlib.decompress(s)\n    except Exception: d = s\n    txt = d.decode('latin-1')\n    print(\"=== stream\", si, \"===\")\n    blocks = re.findall(r'BT.*?ET', txt, re.S)\n    items = []\n    for b in blocks:\n        m = re.search(r'Tm\\s+[\\d.\\-]+\\s+[\\d.\\-]+\\s+[\\d.\\-]+\\s+[\\d.\\-]+\\s+([\\d.\\-]+)\\s+([\\d.\\-]+)', b)\n        if not m: continue\n        e, f = float(m.group(1)), float(m.group(2))\n        cs = []\n        for h in re.findall(r'<[0-9A-Fa-f]+>', b):\n            cs.extend(codes_of(h))\n        items.append((f, e, decode(cs)))\n    for f, e, t in sorted(items, key=lambda z: -z[0]):\n        print(\"f=%8.1f x=%7.1f  %s\" % (f, e, t))\nEOF\npython3 pos5.py"
