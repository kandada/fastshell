.compile(\n        rb\"([A-Za-z]\\\\d+)\\\\s+[\\\\d.]+\\\\s+Tf\"                       # 1:字体切换\n        rb\"|<([0-9A-Fa-f\\\\s]+)>\\\\s*Tj\"                            # 2:16进制文本\n        rb\"|\\\\(((?:[^()\\\\\\\\]|\\\\\\\\.)*)\\\\)\\\\s*Tj\"                   # 3:字面量文本\n        rb\"|\\\\[(.*?)\\\\]\\\\s*TJ\"                                    # 4:TJ数组\n        rb\"|([\\\\d.+-]+)\\\\s+([\\\\d.+-]+)\\\\s+([\\\\d.+-]+)\\\\s+([\\\\d.+-]+)\\\\s+([\\\\d.+-]+)\\\\s+([\\\\d.+-]+)\\\\s+Tm\"  # 5-10:Tm定位\n        rb\"|([\\\\d.+-]+)\\\\s+([\\\\d.+-]+)\\\\s+Td\"                     # 11-12:Td位移\n        rb\"|(T\\\\*|Td|TD|Tm|BT|ET)\"                                # 13:状态操作\n    )\n    for mt in comb.finditer(content):\n        g = mt.groups()\n        if g[0] is not None:\n            cur_font = g[0].decode()\n        elif g[1] is not None:\n            cmap = fm.get(cur_font, {}) if cur_font else {}\n            chars.append((cur_y, cur_x, decode_hex(g[1], cmap)))\n        elif g[2] is not None:\n            chars.append((cur_y, cur_x, unescape_literal(g[2].decode('latin1'))))\n        elif g[3] is not None:\n            cmap = fm.get(cur_font, {}) if cur_font else {}\n            for atom in RE_HEX_ATOM.finditer(g[3]):\n                chars.append((cur_y, cur_x, decode_hex(atom.group(1), cmap)))\n            for atom in RE_LIT_ATOM.finditer(g[3]):\n                chars.append((cur_y, cur_x, unescape_literal(atom.group(1).decode('latin1'))))\n        elif g[4] is not None:\n            # Tm: 绝对定位(取最后两个数)\n            cur_x, cur_y = float(g[8]), float(g[9])\n        elif g[10] is not None:\n            cur_x += float(g[10])\n            cur_y += float(g[11])\n        else:\n            op = g[12]\n            if op in (b'T*', b'ET'):\n                cur_x, cur_y = 0.0, cur_y  # 换行(相对), 保持y基线不合并\n                chars.append((cur_y - 0.01, -1.0, \"\\\\n\"))\n            elif op in (b'Td', b'TD', b'Tm'):\n                pass  # 带数字的已在上面处理, 这里忽略裸操作\n            # BT: 文本对象开始, 忽略\n\n    # 按 y 分组(四舍五入), y 大者在上(坐标翻转); 同组按 x 排序\n    groups = {}\n    for y, x, t in chars:\n        if t == \"\\\\n\":\n            groups.setdefault(y, []).append((\"\\\\n\", 0))\n            continue\n        groups.setdefault(int(round(y)), []).append((x, t))\n    lines = []\n    for y in sorted(groups, reverse=True):\n        segs = groups[y]\n        if len(segs) == 1 and segs[0][0] == \"\\\\n\":\n            lines.append(\"\")\n            continue\n        text = \"\"\n        for x, t in segs:\n            if t == \"\\\\n\":\n                text += \" \"\n            else:\n                text += t\n        lines.append(text)\n    return \"\\\\n\".join(lines)'''\nassert old in src, \"block not found\"\nopen('extract_clean.py','w').write(src.replace(old, new))\nprint(\"patched OK\")\nEOF\npython3 extract_clean.py 2>/dev/null"
